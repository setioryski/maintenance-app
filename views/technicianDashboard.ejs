<!DOCTYPE html>
<html lang="en">
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta charset="UTF-8">
  <title>Technician Dashboard - Maintenance Templates</title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
  <style>
    .dropdown-content { display: none; }
    .group-header { cursor: pointer; }
    .transition-dropdown { transition: all 0.3s ease; }
  </style>
</head>
<body class="bg-gray-50">
  <div class="max-w-6xl mx-auto p-4">
    <h1 class="text-3xl font-bold text-center mb-6">Technician Dashboard</h1>
    <h2 class="text-xl font-semibold mb-4">Maintenance Checklist Templates</h2>

    <!-- Search & Filter Bar -->
    <div class="mb-4 flex flex-col sm:flex-row sm:space-x-4">
      <input 
        type="text" 
        id="searchInput" 
        placeholder="Search asset by name..." 
        class="w-full sm:flex-1 border border-gray-300 rounded px-4 py-2 focus:outline-none focus:ring focus:border-blue-300"
      >
      <select id="floorFilter" class="w-full sm:w-auto border border-gray-300 rounded px-4 py-2">
        <option value="">All Floors</option>
        <% floors.forEach(function(floor) { %>
          <option value="<%= floor.name.toLowerCase() %>"><%= floor.name %></option>
        <% }); %>
      </select>
      <select id="categoryFilter" class="w-full sm:w-auto border border-gray-300 rounded px-4 py-2">
        <option value="">All Categories</option>
        <% assetCategories.forEach(function(cat) { %>
          <option value="<%= cat.name.toLowerCase() %>"><%= cat.name %></option>
        <% }); %>
      </select>
    </div>

    <%
      const getAssetIcon = (name) => {
        name = name.toLowerCase();
        if (name.includes('cctv')) return '📷';
        if (name.includes('panoramic')) return '🌅';
        if (name.includes('smoke')) return '🔥';
        return '📦';
      };

      const validAssignments = assignments.filter(a => a.checklist); 
      if (validAssignments.length === 0) { 
    %>
      <p class="text-center text-gray-600">No maintenance checklist templates available.</p>
    <% } else { 
      const groupedAssignments = {};
      validAssignments.forEach(function(assignment) {
        const assetName = assignment.assetName;
        if (!groupedAssignments[assetName]) {
          groupedAssignments[assetName] = [];
        }
        groupedAssignments[assetName].push(assignment);
      });
    %>

    <!-- Desktop View -->
    <div class="hidden sm:block overflow-x-auto">
      <table class="min-w-full bg-white shadow rounded overflow-hidden">
        <thead>
          <tr class="bg-gray-200 text-left text-sm text-gray-700">
            <th class="py-3 px-4">Asset Name</th>
            <th class="py-3 px-4">Checklist Title</th>
            <th class="py-3 px-4">Assigned Date</th>
            <th class="py-3 px-4">Action</th>
          </tr>
        </thead>
        <tbody>
          <% Object.keys(groupedAssignments).forEach(function(assetName) { 
               const group = groupedAssignments[assetName];
               const assetId = assetName.replace(/\s+/g, '-');
          %>
            <!-- Accordion Header -->
            <tr class="bg-white hover:bg-gray-50 border-t border-b cursor-pointer group-header"
                data-group="<%= assetId %>"
                data-floor="<%= group[0].asset.floor?.name?.toLowerCase() || '' %>"
                data-category="<%= group[0].asset.category?.name?.toLowerCase() || '' %>"
                onclick="toggleDropdown('<%= assetId %>')">
              <td class="py-3 px-4 font-semibold text-blue-800 text-base" colspan="4">
                <span class="mr-2"><%= getAssetIcon(assetName) %></span>
                <%= assetName %>
                <span class="float-right">▼</span>
              </td>
            </tr>
            <!-- Accordion Body -->
            <tbody id="<%= assetId %>" class="dropdown-content bg-gray-50 transition-dropdown">
              <% group.forEach(function(assignment) { %>
                <tr class="border-b text-sm">
                  <td class="py-3 px-4 pl-8 text-gray-700"><%= assignment.asset.name %></td>
                  <td class="py-3 px-4 text-gray-600"><%= assignment.checklist.title %></td>
                  <td class="py-3 px-4 text-gray-500"><%= new Date(assignment.assignedAt).toLocaleDateString() %></td>
                  <td class="py-3 px-4">
                    <a href="/technician/checklist/<%= assignment._id %>" 
                       class="text-sm px-4 py-1 bg-blue-100 hover:bg-blue-200 text-blue-800 rounded transition">
                      Do Checklist
                    </a>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          <% }); %>
        </tbody>
      </table>
    </div>

    <!-- Mobile View -->
    <div class="sm:hidden space-y-4">
      <% Object.keys(groupedAssignments).forEach(function(assetName) {
           const group = groupedAssignments[assetName];
           const assetId = assetName.replace(/\s+/g, '-');
      %>
        <div class="border rounded-lg shadow bg-white"
             data-floor="<%= group[0].asset.floor?.name?.toLowerCase() || '' %>"
             data-category="<%= group[0].asset.category?.name?.toLowerCase() || '' %>">
          <div class="bg-gray-100 px-4 py-3 font-semibold flex justify-between items-center cursor-pointer"
               id="header-<%= assetId %>" onclick="toggleDropdownMobile('<%= assetId %>')">
            <span class="text-sm text-blue-800"><%= getAssetIcon(assetName) %> <%= assetName %></span>
            <span id="arrow-<%= assetId %>" class="transition-transform duration-200">▼</span>
          </div>
          <div id="<%= assetId %>-mobile" class="dropdown-content transition-dropdown">
            <% group.forEach(function(assignment) { %>
              <div class="px-4 py-3 border-t space-y-1">
                <p class="text-sm font-bold text-gray-800"><%= assignment.checklist.title %></p>
                <p class="text-xs text-gray-500">📅 <%= new Date(assignment.assignedAt).toLocaleDateString() %></p>
                <a href="/technician/checklist/<%= assignment._id %>" 
                   class="block mt-2 text-center text-sm px-4 py-1 bg-blue-100 hover:bg-blue-200 text-blue-800 rounded transition">
                  Do Checklist
                </a>
              </div>
            <% }); %>
          </div>
        </div>
      <% }); %>
    </div>
    <% } %>
  </div>

  <!-- Report Link -->
  <div class="mt-4 text-center hidden sm:block">
    <a href="/technician/report" class="text-blue-500 hover:text-blue-700 font-semibold">
      View All Completed Checklist Reports
    </a>
  </div>

  <!-- Desktop Nav -->
  <div class="max-w-6xl mx-auto mt-4 hidden sm:flex justify-end space-x-4">
    <a href="/technician/dashboard" class="text-blue-500 hover:text-blue-700">Dashboard</a>
    <a href="/logout" class="text-blue-500 hover:text-blue-700">Logout</a>
  </div>

  <!-- Mobile Bottom Nav -->
  <div class="fixed inset-x-0 bottom-0 bg-white border-t shadow sm:hidden">
    <div class="flex justify-around py-2">
      <a href="/technician/dashboard" class="flex flex-col items-center text-blue-500">
        <svg class="w-6 h-6 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M3 12l2-2m0 0l7-7 7 7M13 5v6h6"/>
        </svg>
        <span class="text-xs">Dashboard</span>
      </a>
      <a href="/technician/report" class="flex flex-col items-center text-blue-500">
        <svg class="w-6 h-6 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M9 17v-6a2 2 0 012-2h2a2 2 0 012 2v6m-6 0h6"/>
        </svg>
        <span class="text-xs">Reports</span>
      </a>
      <a href="/logout" class="flex flex-col items-center text-blue-500">
        <svg class="w-6 h-6 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M17 16l4-4m0 0l-4-4m4 4H7"/>
        </svg>
        <span class="text-xs">Logout</span>
      </a>
    </div>
  </div>

  <!-- JS for accordion -->
  <script>
    function toggleDropdown(id) {
      const dropdown = document.getElementById(id);
      dropdown.style.display = (dropdown.style.display === 'table-row-group') ? 'none' : 'table-row-group';
    }

    function toggleDropdownMobile(id) {
      const dropdown = document.getElementById(id + '-mobile');
      const arrow = document.getElementById('arrow-' + id);
      if (dropdown.style.display === 'block') {
        dropdown.style.display = 'none';
        arrow.style.transform = 'rotate(0deg)';
      } else {
        dropdown.style.display = 'block';
        arrow.style.transform = 'rotate(180deg)';
      }
    }

    function filterTable() {
      const searchValue = document.getElementById('searchInput').value.toLowerCase();
      const floorValue = document.getElementById('floorFilter').value;
      const categoryValue = document.getElementById('categoryFilter').value;

      const headers = document.getElementsByClassName('group-header');
      for (let i = 0; i < headers.length; i++) {
        const header = headers[i];
        const assetName = header.textContent.replace('▼', '').trim().toLowerCase();
        const assetFloor = header.getAttribute('data-floor') || "";
        const assetCategory = header.getAttribute('data-category') || "";
        const groupId = header.getAttribute('data-group');

        if (
          assetName.includes(searchValue) &&
          (floorValue === "" || assetFloor === floorValue) &&
          (categoryValue === "" || assetCategory === categoryValue)
        ) {
          header.style.display = "";
          if (groupId) document.getElementById(groupId).style.display = "";
        } else {
          header.style.display = "none";
          if (groupId) document.getElementById(groupId).style.display = "none";
        }
      }

      const mobileCards = document.querySelectorAll('[data-floor][data-category]');
      mobileCards.forEach(card => {
        const cardFloor = card.getAttribute('data-floor') || "";
        const cardCategory = card.getAttribute('data-category') || "";
        const cardAssetName = card.querySelector('.font-semibold')?.textContent.toLowerCase() || "";

        if (
          cardAssetName.includes(searchValue) &&
          (floorValue === "" || cardFloor === floorValue) &&
          (categoryValue === "" || cardCategory === categoryValue)
        ) {
          card.style.display = "";
        } else {
          card.style.display = "none";
        }
      });
    }

    document.getElementById('searchInput').addEventListener('input', filterTable);
    document.getElementById('floorFilter').addEventListener('change', filterTable);
    document.getElementById('categoryFilter').addEventListener('change', filterTable);
  </script>
</body>
</html>
