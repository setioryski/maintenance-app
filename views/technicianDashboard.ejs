<!DOCTYPE html>
<html lang="en">
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta charset="UTF-8">
  <title>Technician Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
  
  <link rel="manifest" href="/manifest.json">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="MaintApp">
  <meta name="theme-color" content="#4a90e2"/>
  <link rel="apple-touch-icon" href="/image/logo.png">

</head>
<body class="bg-gray-50">

  <script>
    // Redirect non-technician users to their correct dashboard when online
    const userRole = "<%= locals.user ? user.userRole : '' %>";
    if (navigator.onLine && userRole && userRole !== 'technician') {
        const dashboardUrls = {
            'superuser': '/admin/dashboard',
            'manager': '/manager/dashboard',
            'spv': '/spv/dashboard'
        };
        if (dashboardUrls[userRole]) {
            window.location.href = dashboardUrls[userRole];
        }
    }
  </script>
  
  <header class="bg-white shadow-sm sticky top-0 z-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center h-16">
        <div class="flex items-center">
            <div class="flex-shrink-0">
             <img src="/image/logo.png" alt="Company Logo" class="h-8">
            </div>
            <div id="status-indicator-mobile" class="md:hidden flex items-center space-x-2 ml-4 px-2 py-1 rounded-full text-xs">
                <span id="status-dot-mobile" class="w-2 h-2 rounded-full"></span>
                <span id="status-text-mobile" class="font-semibold"></span>
            </div>
        </div>

        <div class="hidden md:flex items-center space-x-4">
            <div id="status-indicator-desktop" class="flex items-center space-x-2 px-3 py-1 rounded-full">
                <span id="status-dot-desktop" class="w-3 h-3 rounded-full"></span>
                <span id="status-text-desktop" class="text-sm font-semibold"></span>
            </div>
            <a href="/technician/dashboard" class="bg-blue-600 text-white px-3 py-2 rounded-md text-sm font-medium">Dashboard</a>
            <a id="my-reports-link-desktop" href="/technician/report" class="text-gray-500 hover:bg-gray-200 hover:text-gray-900 px-3 py-2 rounded-md text-sm font-medium">My Reports</a>
            <a href="/logout" class="text-gray-500 hover:bg-gray-200 hover:text-gray-900 px-3 py-2 rounded-md text-sm font-medium">Logout</a>
        </div>
        <div class="md:hidden">
          <a href="/logout" class="text-gray-500 text-sm">Logout</a>
        </div>
      </div>
    </div>
  </header>

  <main class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
    <div class="px-4 py-6 sm:px-0">
        <div id="pending-sync-alert" class="hidden mb-6 p-4 bg-yellow-100 border-l-4 border-yellow-500 text-yellow-700 rounded-lg flex items-center justify-between">
            <div>
                <p class="font-bold">Work Saved Offline</p>
                <p>You have <strong id="pending-sync-count">0</strong> submission(s) waiting to be synced.</p>
            </div>
            <button id="sync-now-btn" class="bg-yellow-500 hover:bg-yellow-600 text-white font-bold py-2 px-4 rounded">
                Sync Now
            </button>
        </div>

        <div class="flex flex-col md:flex-row items-start justify-between mb-6">
            <div>
                <h1 class="text-3xl font-bold text-gray-900">Technician Dashboard</h1>
                <p class="text-sm text-gray-500">Here are your assigned maintenance tasks and recent activities.</p>
            </div>
            <div class="flex space-x-2 mt-4 md:mt-0">
                <button id="scan-qr-btn" class="bg-purple-600 hover:bg-purple-700 text-white font-semibold py-2 px-4 rounded-lg shadow-sm transition duration-300 flex items-center">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                    Scan QR Code
                </button>
            </div>
        </div>

        <div id="qr-reader" class="hidden mx-auto md:w-96 mb-6"></div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <div class="lg:col-span-2">
                <div id="tasks-container" class="bg-white p-6 rounded-lg shadow-lg">
                    <h2 class="text-xl font-bold mb-4">My Maintenance Tasks</h2>

                    <form id="asset-filter-form" class="mb-6 p-4 bg-gray-50 rounded-lg border">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 items-end">
                            <input type="text" name="search" value="<%= filters.search %>" class="col-span-1 sm:col-span-2 border border-gray-300 rounded-md p-2 focus:ring-blue-500 focus:border-blue-500" placeholder="Search asset name...">
                            <select name="floor" id="floor-filter" class="border border-gray-300 rounded-md p-2 focus:ring-blue-500 focus:border-blue-500">
                                <option value="all">All Floors</option>
                                <% floors.forEach(function(floor) { %><option value="<%= floor._id %>" <%= filters.floor === floor._id.toString() ? 'selected' : '' %>><%= floor.name %></option><% }); %>
                            </select>
                            <select name="zone" id="zone-filter" class="border border-gray-300 rounded-md p-2 focus:ring-blue-500 focus:border-blue-500">
                                <option value="all">All Zones</option>
                                <% zones.forEach(function(zone) { %>
                                    <%# The data-floor attribute holds the Floor ID %>
                                    <option value="<%= zone._id %>" <%= filters.zone === zone._id.toString() ? 'selected' : '' %> data-floor="<%= zone.floor %>"><%= zone.name %></option>
                                <% }); %>
                            </select>
                            <select name="category" class="border border-gray-300 rounded-md p-2 focus:ring-blue-500 focus:border-blue-500">
                                <option value="all">All Categories</option>
                                <% assetCategories.forEach(function(cat) { %><option value="<%= cat._id %>" <%= filters.category === cat._id.toString() ? 'selected' : '' %>><%= cat.name %></option><% }); %>
                            </select>
                            <button type="submit" class="bg-blue-600 text-white font-bold py-2 px-4 rounded-lg shadow-sm">Filter</button>
                        </div>
                    </form>

                    <div id="assignments-list">
                      <%# Initial rendering is done by EJS on server %>
                      <%# JavaScript will replace this content when offline %>
                      <%
                          const getAssetIcon = (name) => {
                              name = (name || '').toLowerCase();
                              if (name.includes('cctv')) return '📷';
                              if (name.includes('panoramic')) return '🌅';
                              if (name.includes('smoke') || name.includes('fire')) return '🔥';
                              if (name.includes('ahu')) return '💨';
                              if (name.includes('elevator')) return '↕️';
                              if (name.includes('generator')) return '⚡️';
                              return '📦';
                          };
                          const validAssignments = assignments.filter(a => a.checklist && a.asset);
                          if (validAssignments.length === 0 && !locals.offlineRender) { // Check for offlineRender flag if needed
                      %>
                      <div class="text-center py-12">
                          <h3 class="text-lg font-medium text-gray-700">No maintenance tasks found.</h3>
                          <p class="text-gray-500 mt-1">Try adjusting your filters or check back later.</p>
                      </div>
                      <% } else if (!locals.offlineRender) { // Render only if not offline rendering via JS
                          const groupedAssignments = {};
                          validAssignments.forEach(function(assignment) {
                              const assetId = assignment.asset._id.toString();
                              if (!groupedAssignments[assetId]) {
                                  groupedAssignments[assetId] = { asset: assignment.asset, checklists: [] };
                              }
                              groupedAssignments[assetId].checklists.push(assignment);
                          });
                      %>
                      <div class="space-y-4">
                          <% Object.keys(groupedAssignments).forEach(function(assetId) {
                              const group = groupedAssignments[assetId];
                              const asset = group.asset;
                              const assetName = asset.name;
                              const uniqueGroupId = `asset-group-${assetId}`;
                          %>
                          <div class="rounded-lg shadow-sm bg-white overflow-hidden border asset-card"
                              data-name="<%= assetName.toLowerCase() %>"
                              data-floor-id="<%= asset.floor?._id?.toString() || '' %>"
                              data-zone-id="<%= asset.zone?._id?.toString() || '' %>"
                              data-category-id="<%= asset.category?._id?.toString() || '' %>">
                              <div class="bg-gray-50 px-4 py-3 font-semibold flex justify-between items-center cursor-pointer hover:bg-gray-100 transition"
                                  onclick="toggleDropdown('<%= uniqueGroupId %>')">
                                  <div class="flex items-center">
                                      <span class="text-xl mr-3"><%= getAssetIcon(assetName) %></span>
                                      <div>
                                          <p class="text-md text-gray-800"><%= assetName %></p>
                                          <p class="text-xs text-gray-500">
                                              Fl. <%= asset.floor?.name || 'N/A' %> / Zone <%= asset.zone?.name || 'N/A' %> / <%= asset.location %>
                                          </p>
                                      </div>
                                  </div>
                                  <span id="arrow-<%= uniqueGroupId %>" class="transition-transform duration-200 transform text-gray-500">▼</span>
                              </div>
                              <div id="<%= uniqueGroupId %>" class="dropdown-content hidden p-4 space-y-3">
                                  <% group.checklists.forEach(function(assignment) { %>
                                  <div class="flex flex-col sm:flex-row justify-between sm:items-center p-3 border rounded-md hover:bg-gray-50">
                                      <div>
                                          <p class="font-semibold text-gray-800"><%= assignment.checklist.title %></p>
                                          <p class="text-xs text-gray-500">Assigned: <%= new Date(assignment.assignedAt).toLocaleDateString() %></p>
                                      </div>
                                      <button onclick="startChecklist('<%= assignment._id %>')" class="mt-2 sm:mt-0 text-center text-sm px-4 py-2 bg-blue-100 hover:bg-blue-200 text-blue-800 font-semibold rounded-lg transition">
                                          Start Checklist
                                      </button>
                                  </div>
                                  <% }); %>
                              </div>
                          </div>
                          <% }); %>
                      </div>
                      <% } %>
                    </div>
                    <div id="pagination-container">
                        <% if (!locals.offlineRender && totalPages > 1) { // Render pagination only if online %>
                            <div class="px-6 py-4 bg-white border-t flex flex-col xs:flex-row items-center xs:justify-between">
                                <span class="text-xs xs:text-sm text-gray-700">
                                    Showing page <%= currentPage %> of <%= totalPages %>
                                </span>
                                <div class="inline-flex mt-2 xs:mt-0">
                                    <% const queryParams = new URLSearchParams(filters); %>
                                    <% if (parseInt(currentPage) > 1) { %>
                                        <% queryParams.set('page', parseInt(currentPage) - 1) %>
                                        <a href="/technician/dashboard?<%= queryParams.toString() %>" class="text-sm bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-2 px-4 rounded-l">
                                            Prev
                                        </a>
                                    <% } %>
                                    <% if (parseInt(currentPage) < totalPages) { %>
                                        <% queryParams.set('page', parseInt(currentPage) + 1) %>
                                        <a href="/technician/dashboard?<%= queryParams.toString() %>" class="text-sm bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-2 px-4 rounded-r">
                                            Next
                                        </a>
                                    <% } %>
                                </div>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>

             <div class="bg-white p-6 rounded-lg shadow-lg">
                <h2 class="text-xl font-bold mb-4">Recent Activities</h2>
                <div class="h-96 overflow-y-auto">
                    <ul>
                        <% if (locals.activities && activities.length > 0) { %>
                            <% activities.forEach(function(activity) { %>
                                <li class="border-b last:border-b-0 py-3">
                                    <p class="text-sm text-gray-800"><strong><%= (activity.user && activity.user.name) || (activity.user.id && activity.user.id.name) || 'System' %></strong> (<%= activity.role %>) <%= activity.action %></p>
                                    <p class="text-xs text-gray-500 mt-1"><%= new Date(activity.timestamp).toLocaleString() %></p>
                                </li>
                            <% }); %>
                        <% } else { %>
                            <p class="text-gray-500">No recent activities.</p>
                        <% } %>
                    </ul>
                </div>
            </div>
        </div>
    </div>
  </main>

  <div class="fixed inset-x-0 bottom-0 bg-white border-t shadow-lg md:hidden">
    <div class="flex justify-around py-2">
      <a href="/technician/dashboard" class="flex flex-col items-center text-blue-600">
        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20"><path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"></path></svg>
        <span class="text-xs">Dashboard</span>
      </a>
      <a id="my-reports-link-mobile" href="/technician/report" class="flex flex-col items-center text-gray-500 hover:text-blue-600">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-6a2 2 0 012-2h2a2 2 0 012 2v6m-6 0h6"></path></svg>
        <span class="text-xs">My Reports</span>
      </a>
    </div>
  </div>
  
  <div id="sync-modal" class="fixed z-20 inset-0 overflow-y-auto hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
        <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" aria-hidden="true"></div>
        <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>
        <div class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full">
        <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
            <div class="sm:flex sm:items-start">
            <div id="sync-modal-icon" class="mx-auto flex-shrink-0 flex items-center justify-center h-12 w-12 rounded-full bg-blue-100 sm:mx-0 sm:h-10 sm:w-10">
                <svg class="h-6 w-6 text-blue-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 12L3 12m4 4l4-4m6 0v12m0-12l4 4m-4-4l-4 4" />
                </svg>
            </div>
            <div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left">
                <h3 class="text-lg leading-6 font-medium text-gray-900" id="sync-modal-title">
                Confirm Sync
                </h3>
                <div class="mt-2">
                <p class="text-sm text-gray-500" id="sync-modal-body">
                    Are you sure you want to sync your offline data with the server?
                </p>
                </div>
            </div>
            </div>
        </div>
        <div class="bg-gray-50 px-4 py-3 sm:px-6 sm:flex sm:flex-row-reverse">
            <button id="confirm-sync-btn" type="button" class="w-full inline-flex justify-center rounded-md border border-transparent shadow-sm px-4 py-2 bg-blue-600 text-base font-medium text-white hover:bg-blue-700 sm:ml-3 sm:w-auto sm:text-sm">
            Sync
            </button>
            <button id="cancel-sync-btn" type="button" class="mt-3 w-full inline-flex justify-center rounded-md border border-gray-300 shadow-sm px-4 py-2 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 sm:mt-0 sm:w-auto sm:text-sm">
            Cancel
            </button>
        </div>
        </div>
    </div>
  </div>


  <script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>
  <script src="https://unpkg.com/dexie@3.2.5/dist/dexie.js"></script>
  <script src="/js/db.js"></script>

  <script>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/service-worker.js');
      });
    }

    async function syncWithServer() {
        if (!navigator.onLine) return;
        try {
            const response = await fetch('/api/technician/sync-data');
            if (!response.ok) throw new Error(`Server responded with status: ${response.status}`);
            const data = await response.json();
            await cacheData(data.assets, data.assignments, data.checklists);
            console.log("Successfully synced with server.");
        } catch (error) {
            console.error("Failed to sync with server:", error);
        }
    }

    // --- START OF OFFLINE RENDERING LOGIC ---
    let allOfflineAssignments = [];
    const ITEMS_PER_PAGE = 10; // Adjust as needed

    const getAssetIcon = (name) => {
        name = (name || '').toLowerCase();
        if (name.includes('cctv')) return '📷';
        if (name.includes('panoramic')) return '🌅';
        if (name.includes('smoke') || name.includes('fire')) return '🔥';
        if (name.includes('ahu')) return '💨';
        if (name.includes('elevator')) return '↕️';
        if (name.includes('generator')) return '⚡️';
        return '📦';
    };

    function renderAssignments(assignmentsToRender, currentPage) {
        const listEl = document.getElementById('assignments-list');
        const paginationEl = document.getElementById('pagination-container');
        listEl.innerHTML = '';
        paginationEl.innerHTML = '';

        if (!assignmentsToRender || assignmentsToRender.length === 0) {
            listEl.innerHTML = `
                <div class="text-center py-12">
                    <h3 class="text-lg font-medium text-gray-700">No maintenance tasks found.</h3>
                    <p class="text-gray-500 mt-1">Try adjusting your filters or check back later.</p>
                </div>`;
            return;
        }

        const totalItems = assignmentsToRender.length;
        const totalPages = Math.ceil(totalItems / ITEMS_PER_PAGE);
        const startIndex = (currentPage - 1) * ITEMS_PER_PAGE;
        const endIndex = startIndex + ITEMS_PER_PAGE;
        const paginatedAssignments = assignmentsToRender.slice(startIndex, endIndex);

        const groupedAssignments = {};
        paginatedAssignments.forEach(function(assignment) {
            // Ensure asset exists before trying to access its ID
            if (!assignment.asset || !assignment.asset._id) return;
            const assetId = assignment.asset._id.toString();
            if (!groupedAssignments[assetId]) {
                groupedAssignments[assetId] = {
                    asset: assignment.asset,
                    checklists: []
                };
            }
            groupedAssignments[assetId].checklists.push(assignment);
        });

        let html = '<div class="space-y-4">';
        Object.values(groupedAssignments).forEach(group => {
            const asset = group.asset;
             if (!asset) return; // Skip if asset data is missing
            const uniqueGroupId = `asset-group-${asset._id}`;
            html += `
                <div class="rounded-lg shadow-sm bg-white overflow-hidden border asset-card"
                     data-name="${asset.name ? asset.name.toLowerCase() : ''}"
                     data-floor-id="${asset.floor?._id?.toString() || ''}"
                     data-zone-id="${asset.zone?._id?.toString() || ''}"
                     data-category-id="${asset.category?._id?.toString() || ''}"
                     >
                    <div class="bg-gray-50 px-4 py-3 font-semibold flex justify-between items-center cursor-pointer hover:bg-gray-100 transition"
                        onclick="toggleDropdown('${uniqueGroupId}')">
                        <div class="flex items-center">
                            <span class="text-xl mr-3">${getAssetIcon(asset.name)}</span>
                            <div>
                                <p class="text-md text-gray-800">${asset.name || 'N/A'}</p>
                                <p class="text-xs text-gray-500">
                                    Fl. ${asset.floor?.name || 'N/A'} / Zone ${asset.zone?.name || 'N/A'} / ${asset.location || 'N/A'}
                                </p>
                            </div>
                        </div>
                        <span id="arrow-${uniqueGroupId}" class="transition-transform duration-200 transform text-gray-500">▼</span>
                    </div>
                    <div id="${uniqueGroupId}" class="dropdown-content hidden p-4 space-y-3">
                        ${group.checklists.map(assignment => `
                        <div class="flex flex-col sm:flex-row justify-between sm:items-center p-3 border rounded-md hover:bg-gray-50">
                            <div>
                                <p class="font-semibold text-gray-800">${assignment.checklist?.title || 'N/A'}</p>
                                <p class="text-xs text-gray-500">Assigned: ${assignment.assignedAt ? new Date(assignment.assignedAt).toLocaleDateString() : 'N/A'}</p>
                            </div>
                            <button onclick="startChecklist('${assignment._id}')" class="mt-2 sm:mt-0 text-center text-sm px-4 py-2 bg-blue-100 hover:bg-blue-200 text-blue-800 font-semibold rounded-lg transition">
                                Start Checklist
                            </button>
                        </div>
                        `).join('')}
                    </div>
                </div>`;
        });
        html += '</div>';
        listEl.innerHTML = html;

        // Render pagination
        if (totalPages > 1) {
            let paginationHTML = `
                <div class="px-6 py-4 bg-white border-t flex flex-col xs:flex-row items-center xs:justify-between">
                    <span class="text-xs xs:text-sm text-gray-700">
                        Showing ${startIndex + 1} to ${Math.min(endIndex, totalItems)} of ${totalItems} Tasks (Offline)
                    </span>
                    <div class="inline-flex mt-2 xs:mt-0">`;
            if (currentPage > 1) {
                paginationHTML += `<button onclick="handleOfflinePageChange(${currentPage - 1})" class="text-sm bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-2 px-4 rounded-l">Prev</button>`;
            } else {
                 paginationHTML += `<span class="text-sm bg-gray-100 text-gray-400 font-semibold py-2 px-4 rounded-l">Prev</span>`; // Disabled state
            }
            if (currentPage < totalPages) {
                paginationHTML += `<button onclick="handleOfflinePageChange(${currentPage + 1})" class="text-sm bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-2 px-4 rounded-r">Next</button>`;
            } else {
                 paginationHTML += `<span class="text-sm bg-gray-100 text-gray-400 font-semibold py-2 px-4 rounded-r">Next</span>`; // Disabled state
            }
            paginationHTML += `</div></div>`;
            paginationEl.innerHTML = paginationHTML;
        }
    }

    function handleOfflineFilter() {
        const search = document.querySelector('input[name="search"]').value.toLowerCase();
        const floor = document.getElementById('floor-filter').value;
        const zone = document.getElementById('zone-filter').value;
        const category = document.querySelector('select[name="category"]').value;

        const filtered = allOfflineAssignments.filter(a => {
            const asset = a.asset;
             if (!asset) return false; // Skip if asset data is missing
            // Asset names, floor/zone/category IDs are stored directly on the asset object from the sync
            const nameMatch = asset.name ? asset.name.toLowerCase().includes(search) : false;
            const floorMatch = floor === 'all' || asset.floor?._id === floor;
            const zoneMatch = zone === 'all' || asset.zone?._id === zone;
            const categoryMatch = category === 'all' || asset.category?._id === category;
            return nameMatch && floorMatch && zoneMatch && categoryMatch;
        });

        renderAssignments(filtered, 1); // Reset to page 1 on new filter
    }

    function handleOfflinePageChange(newPage) {
        // Re-apply filters to get the full list before paginating for the new page
        handleOfflineFilter(); // This resets to page 1, need to adjust
        
        // --- Correction: Re-filter and render the specific page ---
        const search = document.querySelector('input[name="search"]').value.toLowerCase();
        const floor = document.getElementById('floor-filter').value;
        const zone = document.getElementById('zone-filter').value;
        const category = document.querySelector('select[name="category"]').value;

        const filtered = allOfflineAssignments.filter(a => {
            const asset = a.asset;
            if (!asset) return false;
            const nameMatch = asset.name ? asset.name.toLowerCase().includes(search) : false;
            const floorMatch = floor === 'all' || asset.floor?._id === floor;
            const zoneMatch = zone === 'all' || asset.zone?._id === zone;
            const categoryMatch = category === 'all' || asset.category?._id === category;
            return nameMatch && floorMatch && zoneMatch && categoryMatch;
        });
        
        renderAssignments(filtered, newPage); // Render the requested page
    }
    
    async function renderOfflineDashboard() {
        console.log("Rendering offline dashboard...");
        const data = await getAllOfflineData(); // Fetch all data needed
        allOfflineAssignments = data.assignments || []; // Store globally for filtering
        console.log(`Loaded ${allOfflineAssignments.length} assignments offline.`);
        
        // Detach online submit listener and attach offline filter handler
        const filterForm = document.getElementById('asset-filter-form');
        filterForm.removeEventListener('submit', handleOnlineSubmit); // Remove default submit
        filterForm.addEventListener('submit', (e) => {
             e.preventDefault(); // Prevent page reload
             handleOfflineFilter(); // Trigger offline filtering
        });
        // Also trigger filter on dropdown changes for immediate feedback
        document.getElementById('floor-filter').addEventListener('change', handleOfflineFilter);
        document.getElementById('zone-filter').addEventListener('change', handleOfflineFilter);
        document.querySelector('select[name="category"]').addEventListener('change', handleOfflineFilter);
        document.querySelector('input[name="search"]').addEventListener('input', handleOfflineFilter); // Filter as user types

        renderAssignments(allOfflineAssignments, 1); // Initial render of page 1
    }
    
    // Placeholder for the online submit handler
    function handleOnlineSubmit(e) {
         // This function should ideally not be called offline,
         // but if it is, prevent default and do nothing or show message.
         e.preventDefault();
         console.log("Attempted form submission while offline handler was attached.");
         // alert("Cannot submit filter form while offline. Filtering locally.");
    }
    // --- END OF OFFLINE RENDERING LOGIC ---

    document.addEventListener('DOMContentLoaded', (event) => {
      const updateOnlineStatus = async () => {
        const online = navigator.onLine;
        const indicators = [
            { indicator: document.getElementById('status-indicator-desktop'), dot: document.getElementById('status-dot-desktop'), text: document.getElementById('status-text-desktop'), dotClass: 'w-3 h-3' },
            { indicator: document.getElementById('status-indicator-mobile'), dot: document.getElementById('status-dot-mobile'), text: document.getElementById('status-text-mobile'), dotClass: 'w-2 h-2' }
        ];
        const syncNowBtn = document.getElementById('sync-now-btn');
        const pendingSyncAlert = document.getElementById('pending-sync-alert');
        const pendingSyncCount = document.getElementById('pending-sync-count');
        const desktopReportLink = document.getElementById('my-reports-link-desktop');
        const mobileReportLink = document.getElementById('my-reports-link-mobile');
        const filterForm = document.getElementById('asset-filter-form');
        const tasksContainer = document.getElementById('tasks-container'); // Container for tasks + filters

        indicators.forEach(({ indicator, dot, text, dotClass }) => {
             if (!indicator) return; // Add null check
            if (online) {
                dot.className = `${dotClass} rounded-full bg-green-500`;
                text.textContent = 'Online';
                indicator.className = indicator.className.replace(/bg-red-100 text-red-800|bg-gray-100 text-gray-800/g, 'bg-green-100 text-green-800');
            } else {
                dot.className = `${dotClass} rounded-full bg-red-500`;
                text.textContent = 'Offline';
                 indicator.className = indicator.className.replace(/bg-green-100 text-green-800|bg-gray-100 text-gray-800/g, 'bg-red-100 text-red-800');
            }
        });
        
        if (online) {
            console.log("App is online.");
            if(syncNowBtn) syncNowBtn.classList.remove('hidden');
            if (desktopReportLink) desktopReportLink.href = '/technician/report';
            if (mobileReportLink) mobileReportLink.href = '/technician/report';

            // Ensure the form submits normally online
            filterForm.removeEventListener('submit', handleOfflineFilter); // Remove offline handler
            filterForm.removeEventListener('submit', handleOnlineSubmit); // Remove previous online handler just in case
            filterForm.onsubmit = null; // Clear any inline handler
            filterForm.action = '/technician/dashboard'; // Ensure action is set for server filtering
            filterForm.method = 'GET';

            // If coming online after being offline, sync data and potentially reload
            // Check if offline data was previously rendered
            if (tasksContainer.dataset.renderedOffline === 'true') {
                 console.log("Came online, reloading page to fetch server data...");
                 // Set flag to prevent immediate re-render offline if connection drops fast
                 tasksContainer.dataset.renderedOffline = 'false';
                 window.location.reload(); // Reload to get fresh server-rendered page
            } else {
                 // Already online or first load, sync in background
                 await syncWithServer();
                 forceSync(); // Attempt to sync pending items immediately
            }

        } else {
            console.log("App is offline.");
            if(syncNowBtn) syncNowBtn.classList.add('hidden');
            if (desktopReportLink) desktopReportLink.href = '/offline-report.html';
            if (mobileReportLink) mobileReportLink.href = '/offline-report.html';
            // Set flag and render offline data
             tasksContainer.dataset.renderedOffline = 'true';
            await renderOfflineDashboard(); // Use await to ensure data is loaded
        }

        // Update pending count regardless of online/offline status
        const pendingCount = await countPendingSubmissions();
        if (pendingSyncAlert) {
             pendingSyncAlert.classList.toggle('hidden', pendingCount === 0);
             if (pendingSyncCount) pendingSyncCount.textContent = pendingCount;
        }
      };

      // Initial status check
      updateOnlineStatus();

      // Listen for online/offline events
      window.addEventListener('online', () => {
         console.log("Detected online event.");
         updateOnlineStatus();
      });
      window.addEventListener('offline', () => {
           console.log("Detected offline event.");
           updateOnlineStatus();
      });


      // --- Other Event Listeners (QR, Sync Modal) ---
      const scanBtn = document.getElementById('scan-qr-btn');
      const qrReaderElement = document.getElementById('qr-reader');
      let html5QrCode; // Define variable outside
       if (qrReaderElement) { // Check if element exists
            html5QrCode = new Html5Qrcode("qr-reader");
       }

      const onScanSuccess = (decodedText, decodedResult) => {
          if (html5QrCode && html5QrCode.isScanning) {
                html5QrCode.stop().then(() => {
                window.location.href = navigator.onLine ? `/technician/asset/${decodedText}` : `/offline-asset.html#${decodedText}`;
                }).catch(err => console.error("Error stopping scanner:", err));
          } else {
               window.location.href = navigator.onLine ? `/technician/asset/${decodedText}` : `/offline-asset.html#${decodedText}`;
          }
      };

      if(scanBtn && qrReaderElement && html5QrCode){
          scanBtn.addEventListener('click', () => {
                const isHidden = qrReaderElement.classList.contains('hidden');
                if (isHidden) {
                qrReaderElement.classList.remove('hidden');
                html5QrCode.start({ facingMode: "environment" }, { fps: 10, qrbox: { width: 250, height: 250 } }, onScanSuccess, (errorMessage) => { /* Optional error callback */ })
                    .catch(err => console.error(`QR Scanner Error: ${err}`)); // Log error instead of alert
                } else {
                     if (html5QrCode && html5QrCode.isScanning) {
                        html5QrCode.stop().then(() => qrReaderElement.classList.add('hidden')).catch(err => console.error("Error stopping scanner:", err));
                     } else {
                          qrReaderElement.classList.add('hidden');
                     }
                }
           });
      }
      
    const syncModal = document.getElementById('sync-modal');
    const syncNowBtn = document.getElementById('sync-now-btn');
    const confirmSyncBtn = document.getElementById('confirm-sync-btn');
    const cancelSyncBtn = document.getElementById('cancel-sync-btn');

     if(syncNowBtn && syncModal){
        syncNowBtn.addEventListener('click', () => {
            syncModal.classList.remove('hidden');
        });
     }
    if(cancelSyncBtn && syncModal){
        cancelSyncBtn.addEventListener('click', () => {
            syncModal.classList.add('hidden');
             // Reset modal state if needed
             document.getElementById('sync-modal-title').textContent = 'Confirm Sync';
             document.getElementById('sync-modal-body').textContent = 'Are you sure you want to sync your offline data with the server?';
             document.getElementById('confirm-sync-btn').classList.remove('hidden');
             cancelSyncBtn.textContent = 'Cancel'; // Reset button text
        });
    }

    if(confirmSyncBtn && syncModal && cancelSyncBtn){
        confirmSyncBtn.addEventListener('click', async () => {
            const modalTitle = document.getElementById('sync-modal-title');
            const modalBody = document.getElementById('sync-modal-body');
            const modalIcon = document.getElementById('sync-modal-icon'); // Assuming you add an icon element

            modalTitle.textContent = 'Syncing...';
            modalBody.textContent = 'Please wait while we sync your data.';
            confirmSyncBtn.disabled = true;
            cancelSyncBtn.disabled = true;
            confirmSyncBtn.classList.add('opacity-50', 'cursor-not-allowed'); // Visual feedback

            const result = await forceSync();

            // Simplified icon logic (assuming you have SVGs or classes ready)
            const successIconHtml = `<svg class="h-6 w-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>`;
            const errorIconHtml = `<svg class="h-6 w-6 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>`;


            if (result.failed > 0) {
                modalTitle.textContent = 'Sync Failed';
                modalBody.textContent = `Could not sync ${result.failed} submission(s). Please check your connection and try again. ${result.successful} synced successfully.`;
                 if (modalIcon) modalIcon.innerHTML = errorIconHtml;
            } else {
                modalTitle.textContent = 'Sync Complete';
                modalBody.textContent = `${result.successful} offline submission(s) have been successfully uploaded.`;
                 if (modalIcon) modalIcon.innerHTML = successIconHtml;
            }

            confirmSyncBtn.disabled = false;
            cancelSyncBtn.textContent = 'Close'; // Change cancel to close
            cancelSyncBtn.disabled = false;
            confirmSyncBtn.classList.add('hidden'); // Hide the sync button after completion/failure
            confirmSyncBtn.classList.remove('opacity-50', 'cursor-not-allowed');


            updateOnlineStatus(); // To update the pending count alert
        });
    }

    // --- Corrected Technician Dashboard Floor/Zone Filter Logic ---
    const floorFilterTech = document.getElementById('floor-filter');
    const zoneFilterTech = document.getElementById('zone-filter');
    // Store original options populated by EJS (which are already division-specific)
    const allTechnicianZoneOptions = Array.from(zoneFilterTech.options);

    function updateZoneFilterTech() {
        const selectedFloorId = floorFilterTech.value;
        const previouslySelectedZoneValue = zoneFilterTech.value;

        zoneFilterTech.innerHTML = ''; // Clear current options

        // Add "All Zones" first
        const allZonesOption = document.createElement('option');
        allZonesOption.value = 'all';
        allZonesOption.textContent = 'All Zones';
        zoneFilterTech.appendChild(allZonesOption);

        let isPreviouslySelectedZoneValid = false;

        // Iterate through the original server/offline-provided options
        allTechnicianZoneOptions.forEach(option => {
            if (option.value === 'all') return; // Skip placeholder

            // data-floor attribute holds the Floor ID
            if (selectedFloorId === 'all' || option.dataset.floor === selectedFloorId) {
                const newOption = option.cloneNode(true);
                zoneFilterTech.appendChild(newOption);
                if (newOption.value === previouslySelectedZoneValue) {
                    isPreviouslySelectedZoneValid = true;
                }
            }
        });

        // Set state and selected value
        if (selectedFloorId === 'all') {
            zoneFilterTech.disabled = true;
            zoneFilterTech.value = 'all';
        } else {
            zoneFilterTech.disabled = false;
            zoneFilterTech.value = isPreviouslySelectedZoneValid ? previouslySelectedZoneValue : 'all';
        }
    }

    if(floorFilterTech){
        floorFilterTech.addEventListener('change', () => {
             updateZoneFilterTech();
             // If offline, trigger client-side filter update
             if (!navigator.onLine) {
                 handleOfflineFilter();
             }
             // Online mode relies on form submission onClicking Filter button
        });
    }
     if(zoneFilterTech){
         zoneFilterTech.addEventListener('change', () => {
             // If offline, trigger client-side filter update
             if (!navigator.onLine) {
                 handleOfflineFilter();
             }
              // Online mode relies on form submission onClicking Filter button
         });
     }


    // Initial setup on page load
    if (floorFilterTech && zoneFilterTech) { // Ensure elements exist before running
         updateZoneFilterTech();
    }
     // --- End of Technician Filter Logic ---

    }); // End DOMContentLoaded

 function toggleDropdown(id) {
     const element = document.getElementById(id);
     const arrow = document.getElementById('arrow-' + id);
     if (element) element.classList.toggle('hidden');
     if (arrow) arrow.classList.toggle('rotate-180');
 }

    function startChecklist(assignmentId) {
        // Use offline page link if offline
        const url = navigator.onLine ? `/technician/checklist/${assignmentId}` : `/offline-checklist.html#${assignmentId}`;
        window.location.href = url;
 }
  </script>
