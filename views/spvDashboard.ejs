<!DOCTYPE html>
<html lang="en">
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta charset="UTF-8">
  <title>SPV Dashboard - Manajemen Checklist & Asset</title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
  <style>
    .cursor-move { cursor: move; }
    .dragging { opacity: 0.5; }
    .message-success { background-color: #d4edda; border-color: #c3e6cb; color: #155724; }
    .message-error { background-color: #f8d7da; border-color: #f5c6cb; color: #721c24; }
  </style>
</head>
<body class="bg-gray-100">
  <header class="fixed top-0 left-0 right-0 bg-blue-600 text-white p-4 shadow z-50">
    <div class="max-w-6xl mx-auto">
      <h1 class="text-xl font-semibold">SPV Dashboard</h1>
    </div>
  </header>
  
  <div class="pt-20 max-w-6xl mx-auto p-4 bg-white shadow-md rounded">
    <% if (message && message.text) { %>
      <div class="p-4 mb-4 text-sm rounded-lg message-<%= message.type %>" role="alert">
        <%= message.text %>
      </div>
    <% } %>

    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between mb-8">
      <h1 class="text-2xl font-bold mb-4 sm:mb-0">Manajemen Checklist & Asset</h1>
      <div class="flex flex-col sm:flex-row space-y-2 sm:space-y-0 sm:space-x-2">
        <a href="/checklists/new" class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded">
          + Buat Checklist Baru
        </a>
        <a href="/assets/new" class="bg-green-500 hover:bg-green-600 text-white px-4 py-2 rounded">
          + Buat Asset Baru
        </a>
      </div>
    </div>

    <div class="mb-8">
      <h2 class="text-xl font-bold mb-4">Manajemen Checklist</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-gray-200">
              <th class="p-2 border">Nama Checklist</th>
              <th class="p-2 border">Jumlah Aset Tersassign</th>
              <th class="p-2 border">Aksi</th>
            </tr>
          </thead>
          <tbody id="checklist-tbody">
            <% checklists.forEach(checklist => { %>
              <tr data-id="<%= checklist._id %>" class="cursor-move">
                <td class="p-2 border"><%= checklist.title %></td>
                <td class="p-2 border"><%= checklist.assignmentCount || 0 %></td>
                <td class="p-2 border">
                  <div class="flex flex-col sm:flex-row gap-2">
                    <a href="/checklists/<%= checklist._id %>/edit" class="bg-yellow-500 hover:bg-yellow-600 text-white px-3 py-1 rounded text-sm">
                      Edit
                    </a>
                    <a href="/checklists/<%= checklist._id %>/delete" 
                       class="bg-red-500 hover:bg-red-600 text-white px-3 py-1 rounded text-sm"
                       onclick="return confirm('Yakin ingin menghapus checklist ini?')">
                      Hapus
                    </a>
                    <a href="/checklists/<%= checklist._id %>/assign" class="bg-green-500 hover:bg-green-600 text-white px-3 py-1 rounded text-sm">
                      Assign
                    </a>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>

    <div>
      <h2 class="text-xl font-bold mb-4">Manajemen Asset</h2>
      
      <div class="mb-4 flex flex-col sm:flex-row sm:space-x-4">
        <div class="flex-1">
          <label for="asset-search" class="block text-gray-700 font-semibold mb-1">
            Search Asset:
          </label>
          <input 
            type="text" 
            id="asset-search" 
            class="w-full border border-gray-300 rounded p-2" 
            placeholder="Enter asset name..."
          >
        </div>
        <div class="flex-1">
          <label for="asset-floor-filter" class="block text-gray-700 font-semibold mb-1">
            Filter by Floor:
          </label>
          <select 
            id="asset-floor-filter" 
            class="w-full border border-gray-300 rounded p-2"
          >
            <option value="all">All Floors</option>
            <% floors.forEach(function(floor) { %>
              <option value="<%= floor.name.toLowerCase() %>"><%= floor.name %></option>
            <% }); %>
          </select>
        </div>
        <div class="flex-1">
          <label for="asset-category-filter" class="block text-gray-700 font-semibold mb-1">
            Filter by Kategori Asset:
          </label>
          <select id="asset-category-filter" class="w-full border border-gray-300 rounded p-2">
            <option value="all">Semua</option>
            <% assetCategories.forEach(function(cat) { %>
              <option value="<%= cat._id %>"><%= cat.name %></option>
            <% }); %>
          </select>
        </div>
      </div>
      
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-gray-200">
              <th class="p-2 border">Nama Asset</th>
              <th class="p-2 border">Kategori</th>
              <th class="p-2 border">Lokasi</th>
              <th class="p-2 border">Lantai</th>
              <th class="p-2 border">Zona</th>
              <th class="p-2 border">Aksi</th>
            </tr>
          </thead>
          <tbody id="asset-tbody">
            <% assets.forEach(asset => { %>
              <tr 
                data-id="<%= asset._id %>" 
                data-category="<%= asset.category ? asset.category._id.toString() : '' %>" 
                data-floor="<%= asset.floor && asset.floor.name ? asset.floor.name.toLowerCase() : '' %>"
                class="cursor-move"
              >
                <td class="p-2 border"><%= asset.name %></td>
                <td class="p-2 border"><%= asset.category ? asset.category.name : 'N/A' %></td>
                <td class="p-2 border"><%= asset.location %></td>
                <td class="p-2 border"><%= asset.floor ? asset.floor.name : 'N/A' %></td>
                <td class="p-2 border"><%= asset.zone ? asset.zone.name : 'N/A' %></td>
                <td class="p-2 border">
                  <div class="flex flex-col sm:flex-row gap-2">
                    <a href="/assets/<%= asset._id %>/edit" class="bg-yellow-500 hover:bg-yellow-600 text-white px-3 py-1 rounded text-sm">
                      Edit
                    </a>
                    <a href="/assets/<%= asset._id %>/delete" 
                       class="bg-red-500 hover:bg-red-600 text-white px-3 py-1 rounded text-sm"
                       onclick="return confirm('Yakin ingin menghapus asset ini?')">
                      Hapus
                    </a>
                     <form action="/assets/<%= asset._id %>/duplicate" method="POST" class="inline">
                        <button type="submit" class="bg-blue-500 hover:bg-blue-600 text-white px-3 py-1 rounded text-sm">
                         Duplicate
                        </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
     <div class="mt-8">
      <h2 class="text-xl font-bold mb-4">News Activity</h2>
      <div class="bg-white shadow rounded-lg p-4 h-64 overflow-y-auto">
        <% if (locals.activities && activities.length > 0) { %>
          <ul>
            <% activities.forEach(function(activity) { %>
              <li class="border-b last:border-b-0 py-2">
                <p class="text-sm text-gray-800">
                  <strong><%= activity.user.name %></strong> (<%= activity.role %>) <%= activity.action %>
                </p>
                <p class="text-xs text-gray-500">
                  <%= new Date(activity.timestamp).toLocaleString() %>
                </p>
              </li>
            <% }); %>
          </ul>
        <% } else { %>
          <p class="text-gray-500">No recent activities in your division.</p>
        <% } %>
      </div>
    </div>
  </div>

  <div class="max-w-6xl mx-auto mt-4 flex flex-col sm:flex-row justify-end space-y-2 sm:space-y-0 sm:space-x-4 px-4 pb-4">
    <a href="/" class="text-blue-500 hover:text-blue-700">Dashboard</a>
    <a href="/spv/report" class="text-blue-500 hover:text-blue-700">Report</a>
    <a href="/logout" class="text-blue-500 hover:text-blue-700">Logout</a>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.14.0/Sortable.min.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      // Only enable drag-and-drop on larger screens
      if (window.innerWidth >= 640) {
        // --- Initialize Sortable for Checklists ---
        var checklistTbody = document.getElementById('checklist-tbody');
        Sortable.create(checklistTbody, {
          animation: 150,
          ghostClass: 'dragging',
          onEnd: function(evt) {
            var order = [];
            checklistTbody.querySelectorAll('tr').forEach(function(row) {
              order.push(row.getAttribute('data-id'));
            });
            fetch('/checklists/sort', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ order: order })
            })
            .then(response => response.json())
            .then(data => console.log(data.message))
            .catch(err => console.error('Checklist sort error:', err));
          }
        });

        // --- Initialize Sortable for Assets ---
        var assetTbody = document.getElementById('asset-tbody');
        Sortable.create(assetTbody, {
          animation: 150,
          ghostClass: 'dragging',
          onEnd: function(evt) {
            var order = [];
            assetTbody.querySelectorAll('tr').forEach(function(row) {
              order.push(row.getAttribute('data-id'));
            });
            fetch('/assets/sort', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ order: order })
            })
            .then(response => response.json())
            .then(data => console.log(data.message))
            .catch(err => console.error('Asset sort error:', err));
          }
        });
      }
    });
    
    // --- Filtering logic for asset table ---
    const assetSearch = document.getElementById('asset-search');
    const assetFloorFilter = document.getElementById('asset-floor-filter');
    const assetCategoryFilter = document.getElementById('asset-category-filter');
    const assetTbody = document.getElementById('asset-tbody');

    function filterAssets() {
      const searchTerm = assetSearch.value.toLowerCase();
      const selectedFloor = assetFloorFilter.value;
      const selectedCategory = assetCategoryFilter.value;
      const rows = assetTbody.querySelectorAll('tr');
      
      rows.forEach(row => {
        const assetName = row.querySelector('td:nth-child(1)').textContent.toLowerCase();
        const assetFloor = row.getAttribute('data-floor');
        const assetCategory = row.getAttribute('data-category');
        
        let show = true;
        if (searchTerm && !assetName.includes(searchTerm)) {
          show = false;
        }
        if (selectedFloor !== 'all' && assetFloor !== selectedFloor) {
          show = false;
        }
        if (selectedCategory !== 'all' && assetCategory !== selectedCategory) {
          show = false;
        }
        row.style.display = show ? '' : 'none';
      });
    }

    assetSearch.addEventListener('input', filterAssets);
    assetFloorFilter.addEventListener('change', filterAssets);
    assetCategoryFilter.addEventListener('change', filterAssets);
  </script>
</body>
</html>