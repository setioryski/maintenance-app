<!DOCTYPE html>
<html lang="en">
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta charset="UTF-8">
  <title>Maintenance Checklist</title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet"/>
</head>
<body class="bg-gray-100">
  <div class="max-w-3xl mx-auto p-4 sm:p-6 pb-24">
    <div class="bg-white shadow-lg rounded-lg p-6">
      <div class="text-center border-b pb-4 mb-6">
        <h1 class="text-2xl font-bold text-gray-800">Maintenance Checklist</h1>
        <p class="text-sm text-gray-500"><%= new Date().toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></p>
      </div>

      <div class="bg-blue-50 p-4 rounded-lg mb-6 border border-blue-200">
        <h2 class="font-bold text-lg text-blue-800"><%= assignment.checklist ? assignment.checklist.title : 'N/A' %></h2>
        <p class="text-sm text-gray-700 mt-1">
          Asset: <strong><%= assignment.asset ? assignment.asset.name : 'N/A' %></strong>
        </p>
         <p class="text-xs text-gray-500">
          Location: Fl. <%= (assignment.asset.floor && assignment.asset.floor.name) ? assignment.asset.floor.name : 'N/A' %>, Zone <%= (assignment.asset.zone && assignment.asset.zone.name) ? assignment.asset.zone.name : 'N/A' %> - <%= assignment.asset.location %>
        </p>
      </div>

      <form id="checklist-form" action="/technician/checklist/<%= assignment._id %>/submit" method="POST" enctype="multipart/form-data">
        <% const tasks = (assignment.checklist && assignment.checklist.tasks) ? assignment.checklist.tasks : []; %>

        <% if (tasks.length > 0) { %>
          <div class="space-y-6">
          <% tasks.forEach(function(task, index) { %>
            <div class="border p-4 rounded-lg shadow-sm task-item bg-white" data-task-id="<%= task._id %>">
              <input type="hidden" name="taskIds[]" value="<%= task._id %>">

              <label class="block text-gray-800 font-semibold mb-3">
                <span class="text-blue-600 mr-2"><%= index + 1 %>.</span><%= task.description %>
                <% if (task.expectedUnit) { %> 
                  <span class="text-xs font-normal text-gray-500">(Unit: <%= task.expectedUnit %><% if (task.minRange != null && task.maxRange != null) { %>, Range: <%= task.minRange %>-<%= task.maxRange %><% } %>)</span> 
                <% } %>
              </label>

              <% if (task.inputType === 'functional') { %>
                <div class="flex space-x-4">
                  <div class="flex-1 p-3 text-center text-green-800 bg-green-100 rounded-lg border-2 border-green-200 cursor-pointer transition-colors duration-200 functional-button" data-value="pass">
                    <input type="radio" name="results[<%= task._id %>]" value="pass" required class="sr-only"/>
                    Pass
                  </div>
                  <div class="flex-1 p-3 text-center text-red-800 bg-red-100 rounded-lg border-2 border-red-200 cursor-pointer transition-colors duration-200 functional-button" data-value="fail">
                    <input type="radio" name="results[<%= task._id %>]" value="fail" required class="sr-only"/>
                    Fail
                  </div>
                </div>
              <% } else if (task.inputType === 'measurement') { %>
                <input
                  type="number"
                  step="any"
                  name="results[<%= task._id %>]"
                  placeholder="Enter value..."
                  class="shadow-sm border rounded w-full py-2 px-3 focus:outline-none focus:ring-2 focus:ring-blue-500"
                  required
                />
              <% } %>
            </div>
          <% }); %>
          </div>
        <% } else { %>
          <p class="text-center text-gray-600">No tasks available for this checklist.</p>
        <% } %>

        <div class="mt-8">
          <label class="block text-gray-700 font-bold mb-2" for="note">Notes / Remarks</label>
          <textarea
            id="note"
            name="note"
            rows="4"
            class="w-full border border-gray-300 rounded-lg p-3 shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
            placeholder="Add any relevant notes here..."
          ></textarea>
        </div>
      </form>
    </div>
  </div>

  <footer class="fixed bottom-0 left-0 right-0 bg-white border-t shadow-lg p-4">
      <div class="max-w-3xl mx-auto flex justify-between items-center">
        <a href="/technician/dashboard" class="text-sm font-medium text-gray-600 hover:text-blue-600">&larr; Back to Dashboard</a>
        <button
          type="submit"
          form="checklist-form"
          class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-6 rounded-lg shadow-md transition duration-300"
        >
          Submit Checklist
        </button>
      </div>
  </footer>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
        // --- FORM VALIDATION SCRIPT ---
        const form = document.getElementById('checklist-form');
        if (form) {
            form.addEventListener('submit', function(event) {
                let allTasksCompleted = true;
                const taskElements = document.querySelectorAll('.task-item');

                taskElements.forEach(taskElement => {
                    const functionalRadios = taskElement.querySelectorAll('input[type="radio"]');
                    const measurementInput = taskElement.querySelector('input[type="number"]');
                    
                    taskElement.style.border = '1px solid #e5e7eb'; 

                    if (measurementInput) {
                        measurementInput.classList.remove('border-red-500', 'ring-red-500', 'border-2');
                    }

                    if (functionalRadios.length > 0) {
                        if (!Array.from(functionalRadios).some(radio => radio.checked)) {
                            allTasksCompleted = false;
                            taskElement.style.border = '2px solid red';
                        }
                    }

                    if (measurementInput) {
                        if (measurementInput.value.trim() === '') {
                            allTasksCompleted = false;
                            measurementInput.classList.add('border-red-500', 'ring-red-500', 'border-2');
                        }
                    }
                });

                if (!allTasksCompleted) {
                    event.preventDefault();
                    alert('Please complete all checklist items before submitting.');
                }
            });
        }

        // --- FUNCTIONAL BUTTON SCRIPT ---
        document.querySelectorAll('.functional-button').forEach(button => {
            button.addEventListener('click', () => {
                const radio = button.querySelector('input[type="radio"]');
                radio.checked = true;

                // Find the parent task item
                const taskItem = button.closest('.task-item');
                if (taskItem) {
                    // Get all buttons within the same task
                    const allButtons = taskItem.querySelectorAll('.functional-button');
                    
                    allButtons.forEach(btn => {
                        const btnRadio = btn.querySelector('input[type="radio"]');
                        if (btnRadio.checked) {
                            // Apply dark style to selected
                            if (btn.dataset.value === 'pass') {
                                btn.classList.remove('bg-green-100', 'text-green-800');
                                btn.classList.add('bg-green-600', 'text-white');
                            } else {
                                btn.classList.remove('bg-red-100', 'text-red-800');
                                btn.classList.add('bg-red-600', 'text-white');
                            }
                        } else {
                            // Reset style for unselected
                            if (btn.dataset.value === 'pass') {
                                btn.classList.add('bg-green-100', 'text-green-800');
                                btn.classList.remove('bg-green-600', 'text-white');
                            } else {
                                btn.classList.add('bg-red-100', 'text-red-800');
                                btn.classList.remove('bg-red-600', 'text-white');
                            }
                        }
                    });
                }
            });
        });
    });
  </script>
</body>
</html>