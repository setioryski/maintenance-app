<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SPV Checklist Report Detail</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .task-item { margin-bottom: 1rem; }
        .task-response { font-weight: bold; }
        .status-ok { color: green; }
        .status-fail { color: red; }
        .has-alert { border-left: 5px solid #ffc107; }
        .rejected-status { color: #dc3545; }
        .verified-status { color: green; }
    </style>
</head>
<body>
<div class="container mt-5">
    <div class="card <%= assignment.hasAlert ? 'has-alert' : '' %>">
        <div class="card-header">
            <h3>Maintenance Report</h3>
        </div>
        <div class="card-body">
            <h4 class="card-title"><%= assignment.checklistTitle %></h4>
            <p class="card-text">
                Review the maintenance checklist report below. You may verify or reject this submission.
            </p>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">Asset Details</div>
<ul class="list-group list-group-flush">
    <li class="list-group-item"><strong>Name:</strong> <%= assignment.assetName || 'N/A' %></li>
    <li class="list-group-item"><strong>Category:</strong> <%= assignment.asset?.category?.name || 'N/A' %></li>
    <li class="list-group-item"><strong>Floor:</strong> <%= assignment.asset?.floor?.name || 'N/A' %></li>
    <li class="list-group-item"><strong>Zone:</strong> <%= assignment.asset?.zone?.name || 'N/A' %></li>
    <li class="list-group-item"><strong>Location:</strong> <%= assignment.asset?.location || 'N/A' %></li>
</ul>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">Report Information</div>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item"><strong>Submitted By:</strong> <%= assignment.submittedBy.name %></li>
                    <li class="list-group-item"><strong>Submission Date:</strong> <%= new Date(assignment.completedAt).toLocaleString() %></li>
                    <li class="list-group-item"><strong>SPV Verification:</strong>
                        <% if (assignment.verifiedBySpv) { %>
                            <span class="verified-status">Verified by <%= assignment.verifiedBySpvUser.name %></span>
                        <% } else { %>
                            Pending
                        <% } %>
                    </li>
                    <li class="list-group-item"><strong>Manager Verification:</strong>
                         <% if (assignment.verifiedByManager) { %>
                            <span class="verified-status">Verified by <%= assignment.verifiedByManagerUser.name %></span>
                        <% } else { %>
                            Pending
                        <% } %>
                    </li>
                    <% if (assignment.verifiedStatus === 'rejected') { %>
                        <li class="list-group-item rejected-status">
                            <strong>Status:</strong> Rejected by <%= assignment.rejectedBy.name %>
                        </li>
                    <% } %>
                </ul>
            </div>
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-header">Checklist Responses</div>
        <div class="card-body">
            <% assignment.tasksSnapshot.forEach(task => { %>
                <div class="task-item">
                    <h6><%= task.description %></h6>
                    <%
                       const response = assignment.responses[task.originalTaskId.toString()];
                       let displayResponse = response;
                       let responseClass = '';

                       if (task.inputType === 'measurement' && response !== null) {
                           const value = parseFloat(response);
                           if (!isNaN(value)) {
                               if (task.minRange != null && task.maxRange != null && (value < task.minRange || value > task.maxRange)) {
                                   responseClass = 'status-fail';
                               } else {
                                   responseClass = 'status-ok';
                               }
                           }
                           displayResponse = `${value} ${task.expectedUnit || ''}`;
                       } else if (task.inputType === 'functional') {
                           if (response === 'fail') {
                               responseClass = 'status-fail';
                               displayResponse = 'Fail';
                           } else {
                               responseClass = 'status-ok';
                               displayResponse = 'OK';
                           }
                       } else if (Array.isArray(response)) {
                           displayResponse = '';
                           response.forEach(url => {
                               displayResponse += `<a href="${url}" target="_blank"><img src="${url}" style="max-width: 150px; margin-right: 10px; border-radius: 5px;"></a>`;
                           });
                       }
                    %>
                    <p class="task-response <%= responseClass %>"><%- displayResponse %></p>
                </div>
            <% }); %>

            <% if (assignment.note) { %>
                <div class="mt-4">
                    <h6>Technician's Note:</h6>
                    <p><%= assignment.note %></p>
                </div>
            <% } %>
        </div>
    </div>
    <div class="mt-4 text-center">
        <a href="/spv/report" class="btn btn-secondary">Back to Reports</a>
        <% if (assignment.verifiedStatus !== 'rejected' && !assignment.verifiedBySpv) { %>
        <form action="/spv/report/<%= assignment._id %>/verify" method="POST" class="d-inline">
            <button type="submit" class="btn btn-success">Verify</button>
        </form>
        <form action="/spv/report/<%= assignment._id %>/reject" method="POST" class="d-inline">
            <button type="submit" class="btn btn-danger">Reject</button>
        </form>
        <% } %>
    </div>
</div>
</body>
</html>