<!DOCTYPE html>
<html lang="en">
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta charset="UTF-8">
  <title>Assign Checklist</title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="bg-gray-100">
  <div class="max-w-2xl mx-auto mt-8 p-4 bg-white shadow-md rounded">
    <h1 class="text-xl font-bold mb-4">Assign Checklist</h1>
    <p class="mb-4">
      Checklist: <strong><%= checklist.title %></strong>
    </p>
    
    <% /* --- CORRECTED FORM ACTION --- */ %>
    <form action="/spv/checklists/<%= checklist._id %>/assign" method="POST">
      <h2 class="text-md font-semibold mb-2">Pilih Asset (hanya asset divisi Anda):</h2>
      <div class="mb-4 h-64 overflow-y-auto border rounded-md p-2">
        <% assets.forEach(asset => { %>
          <div class="flex items-center mb-1 hover:bg-gray-50 p-1 rounded">
            <input
              type="checkbox"
              name="assetIds"
              value="<%= asset._id %>"
              id="asset-<%= asset._id %>"
              class="mr-2 h-4 w-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500"
              <%= assignedAssetIds.includes(asset._id.toString()) ? 'checked' : '' %>
            />
            <label for="asset-<%= asset._id %>" class="w-full">
              <%= asset.name %>
            </label>
          </div>
        <% }); %>
      </div>
      <div class="flex items-center justify-end space-x-4">
        <a href="/spv/dashboard" class="text-gray-600 hover:text-gray-800">
          Batal
        </a>
        <button
          type="submit"
          class="bg-blue-600 hover:bg-blue-700 text-white font-bold px-4 py-2 rounded shadow-sm transition duration-200"
        >
          Simpan Assignment
        </button>
      </div>
    </form>
  </div>
</body>
</html>