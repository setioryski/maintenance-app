<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SPV Report Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="bg-gray-100">
<div class="container mx-auto p-4">
    <h1 class="text-3xl font-bold mb-6 text-center">SPV Maintenance Reports</h1>

    <form method="GET" action="/spv/report" class="mb-4 flex flex-col sm:flex-row gap-4 items-center">
        <div class="flex-1 w-full">
            <label for="status_filter" class="block text-sm font-medium text-gray-700">Filter by Status</label>
            <select name="filter" id="status_filter" onchange="this.form.submit()" class="mt-1 block w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm rounded-md">
                <option value="all" <%= currentFilter === 'all' ? 'selected' : '' %>>All Reports</option>
                <option value="verified_spv" <%= currentFilter === 'verified_spv' ? 'selected' : '' %>>Verified by SPV</option>
                <option value="verified_manager" <%= currentFilter === 'verified_manager' ? 'selected' : '' %>>Verified by Manager</option>
                <option value="has_alert" <%= currentFilter === 'has_alert' ? 'selected' : '' %>>With Alerts</option>
                <option value="rejected" <%= currentFilter === 'rejected' ? 'selected' : '' %>>Rejected</option>
            </select>
        </div>
    </form>

    <div class="overflow-x-auto bg-white shadow rounded-lg">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Asset / Checklist</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Technician / Date</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
            <% if (assignments.length > 0) { %>
                <% assignments.forEach(assignment => { %>
                <tr id="assignment-row-<%= assignment._id %>" data-id="<%= assignment._id %>" class="<%= assignment.verifiedStatus === 'rejected' ? 'bg-red-50' : '' %>">
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm font-medium text-gray-900">
                            <% if (assignment.asset) { %>
                                <%= assignment.asset.name %>
                            <% } else if (assignment.assetSnapshot) { %>
                                <%= assignment.assetSnapshot.name %> (Deleted)
                            <% } else { %>
                                N/A
                            <% } %>
                        </div>
                        <div class="text-sm text-gray-500"><%= assignment.checklistTitle || 'N/A' %></div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm text-gray-900"><%= assignment.submittedByName || 'N/A' %></div>
                        <div class="text-sm text-gray-500"><%= new Date(assignment.completedAt).toLocaleString() %></div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap status-cell">
                        <% if (assignment.verifiedStatus === 'rejected') { %>
                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">Rejected by <%= assignment.rejectedByName || 'N/A' %></span>
                        <% } else if (assignment.verifiedByManager) { %>
                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">Verified by Manager</span>
                        <% } else if (assignment.verifiedBySpv) { %>
                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-blue-100 text-blue-800">Verified by SPV</span>
                        <% } else { %>
                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-gray-100 text-gray-800">Pending SPV Verification</span>
                        <% } %>

                        <% if (assignment.hasAlert) { %>
                            <span class="px-2 ml-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-yellow-100 text-yellow-800">Alert</span>
                        <% } %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium action-cell">
                        <a href="/spv/report/<%= assignment._id %>/detail" class="text-indigo-600 hover:text-indigo-900 mr-4">Detail</a>
                        <% if (assignment.verifiedStatus !== 'rejected' && !assignment.verifiedBySpv) { %>
                             <button type="button" class="text-green-600 hover:text-green-900 verify-btn" data-id="<%= assignment._id %>">Verify</button>
                        <% } %>
                        <% if (assignment.verifiedStatus !== 'rejected' && !assignment.verifiedByManager) { %>
                             <button type="button" class="text-red-600 hover:text-red-900 reject-btn ml-4" data-id="<%= assignment._id %>" data-verified="<%= assignment.verifiedBySpv ? 'true' : 'false' %>">Reject</button>
                        <% } %>
                    </td>
                </tr>
                <% }); %>
            <% } else { %>
                <tr>
                    <td colspan="4" class="px-6 py-4 text-center text-sm text-gray-500">No reports found for the selected filter.</td>
                </tr>
            <% } %>
            </tbody>
        </table>
    </div>
    <div class="mt-6 text-center">
        <a href="/spv/dashboard" class="text-indigo-600 hover:text-indigo-900">Back to Dashboard</a>
    </div>
</div>

<div id="rejection-modal" class="fixed z-10 inset-0 overflow-y-auto hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
  <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
    <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" aria-hidden="true"></div>
    <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>
    <div class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full">
      <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
        <div class="sm:flex sm:items-start">
          <div class="mx-auto flex-shrink-0 flex items-center justify-center h-12 w-12 rounded-full bg-red-100 sm:mx-0 sm:h-10 sm:w-10">
            <svg class="h-6 w-6 text-red-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
          <div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left">
            <h3 class="text-lg leading-6 font-medium text-gray-900" id="modal-title">
              Confirm Rejection
            </h3>
            <div class="mt-2">
              <p class="text-sm text-gray-500">
                This report has already been approved. Are you sure you want to reject it?
              </p>
            </div>
          </div>
        </div>
      </div>
      <div class="bg-gray-50 px-4 py-3 sm:px-6 sm:flex sm:flex-row-reverse">
        <button id="confirm-reject-btn" type="button" class="w-full inline-flex justify-center rounded-md border border-transparent shadow-sm px-4 py-2 bg-red-600 text-base font-medium text-white hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 sm:ml-3 sm:w-auto sm:text-sm">
          Reject
        </button>
        <button id="cancel-reject-btn" type="button" class="mt-3 w-full inline-flex justify-center rounded-md border border-gray-300 shadow-sm px-4 py-2 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 sm:mt-0 sm:w-auto sm:text-sm">
          Cancel
        </button>
      </div>
    </div>
  </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const modal = document.getElementById('rejection-modal');
        const confirmBtn = document.getElementById('confirm-reject-btn');
        const cancelBtn = document.getElementById('cancel-reject-btn');
        let actionUrl = '';
        let rowToUpdate = null;
        const handleAction = async (url, row) => {
            const assignmentId = row.dataset.id;
            try {
                const response = await fetch(url, { 
                    method: 'POST',
                    headers: {
                        'Accept': 'application/json'
                    }
                });
                if (response.status === 401) {
                    alert('Your session has expired. Please log in again.');
                    window.location.href = '/login';
                    return;
                }
                
                const result = await response.json();
                if (result.success) {
                    const statusCell = row.querySelector('.status-cell');
                    const actionCell = row.querySelector('.action-cell');
                    
                    if (result.status === 'verified') {
                        statusCell.innerHTML = `<span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-blue-100 text-blue-800">Verified by SPV</span>`;
                        actionCell.innerHTML = `<a href="/spv/report/${assignmentId}/detail" class="text-indigo-600 hover:text-indigo-900 mr-4">Detail</a>`;
                    } else if (result.status === 'rejected') {
                        statusCell.innerHTML = `<span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">Rejected</span>`;
                        actionCell.innerHTML = `<a href="/spv/report/${assignmentId}/detail" class="text-indigo-600 hover:text-indigo-900 mr-4">Detail</a>`;
                        row.classList.add('bg-red-50');
                    }
                } else {
                    alert('Action failed: ' + result.message);
                }
            } catch (error) {
                console.error('An error occurred:', error);
                alert('An error occurred. Please try again.');
            }
            modal.classList.add('hidden');
        };
        document.querySelectorAll('.verify-btn').forEach(button => {
            button.addEventListener('click', (e) => {
                const assignmentId = e.target.dataset.id;
                const row = document.getElementById(`assignment-row-${assignmentId}`);
                handleAction(`/spv/report/${assignmentId}/verify`, row);
            });
        });
        document.querySelectorAll('.reject-btn').forEach(button => {
            button.addEventListener('click', (e) => {
                const assignmentId = e.target.dataset.id;
                const isVerified = e.target.dataset.verified === 'true';
                rowToUpdate = document.getElementById(`assignment-row-${assignmentId}`);
                actionUrl = `/spv/report/${assignmentId}/reject`;

                if (isVerified) {
                    modal.classList.remove('hidden');
                } else {
                    handleAction(actionUrl, rowToUpdate);
                }
            });
        });

        confirmBtn.addEventListener('click', () => {
            if (actionUrl && rowToUpdate) {
                handleAction(actionUrl, rowToUpdate);
            }
        });
        cancelBtn.addEventListener('click', () => {
            modal.classList.add('hidden');
            actionUrl = '';
            rowToUpdate = null;
        });
    });
</script>
</body>
</html>