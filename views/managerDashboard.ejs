<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Manager Checklist Verification</title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="bg-gray-100">
  <div class="max-w-6xl mx-auto p-6">
    <h1 class="text-3xl font-bold mb-6">Manager Checklist Verification</h1>

    <form method="GET" action="/manager/dashboard" class="mb-4 flex flex-col sm:flex-row sm:space-x-4">
      <div class="flex-1">
        <label class="block text-gray-700 font-semibold mb-1">Filter by Division:</label>
        <select name="division" onchange="this.form.submit()"
                class="w-full border border-gray-300 rounded p-2">
          <option value="all" <%= currentDivision === 'all' ? 'selected' : '' %>>All Divisions</option>
          <% divisions.forEach(div => { %>
            <option value="<%= div._id %>"
              <%= currentDivision === div._id.toString() ? 'selected' : '' %>>
              <%= div.name %>
            </option>
          <% }) %>
        </select>
      </div>
    
      <div class="flex-1">
        <label class="block text-gray-700 font-semibold mb-1">Filter Reports:</label>
        <select name="filter" onchange="this.form.submit()"
                class="w-full border border-gray-300 rounded p-2">
          <option value="all" <%= currentFilter === 'all' ? 'selected' : '' %>>All Reports</option>
          <option value="has_alert" <%= currentFilter === 'has_alert' ? 'selected' : '' %>>With Alerts</option>
          <option value="spv_verified" <%= currentFilter === 'spv_verified' ? 'selected' : '' %>>Verified by SPV</option>
          <option value="manager_verified" <%= currentFilter === 'manager_verified' ? 'selected' : '' %>>Verified by Manager</option>
          <option value="not_verified_spv" <%= currentFilter === 'not_verified_spv' ? 'selected' : '' %>>Not Verified by SPV</option>
        </select>
      </div>
    </form>
    
    <div class="overflow-x-auto">
      <table class="min-w-full bg-white shadow-md rounded border">
        <thead>
          <tr class="bg-gray-200">
            <th class="py-2 px-4 border">Asset</th>
            <th class="py-2 px-4 border">Checklist</th>
            <th class="py-2 px-4 border">Technician</th>
            <th class="py-2 px-4 border">Submitted</th>
            <th class="py-2 px-4 border">Verified Status</th>
            <th class="py-2 px-4 border">Alerts</th>
            <th class="py-2 px-4 border">Action</th>
          </tr>
        </thead>
        <tbody>
          <% assignments.forEach(assignment => { %>
            <tr class="border-b <%= assignment.hasAlert ? 'bg-yellow-100' : '' %>">
              <td class="py-2 px-4 border"><%= assignment.asset?.name || 'N/A' %></td>
              <td class="py-2 px-4 border"><%= assignment.checklist?.title || 'N/A' %></td>
              <td class="py-2 px-4 border"><%= assignment.submittedBy?.name || 'N/A' %></td>
              <td class="py-2 px-4 border"><%= new Date(assignment.completedAt).toLocaleDateString() %></td>
              <td class="py-2 px-4 border">
                <% if (assignment.verifiedByManager) { %>
                  <span class="text-green-600 font-bold">Verified by Manager</span>
                <% } else if (assignment.verifiedBySpv) { %>
                  <span class="text-blue-600 font-bold">Verified by SPV</span>
                <% } else { %>
                  <span class="text-yellow-600 font-bold">Not Verified</span>
                <% } %>
              </td>
               <td class="py-2 px-4 border">
                <% if (assignment.hasAlert) { %>
                  <span class="text-red-600 font-bold">Yes</span>
                <% } else { %>
                  <span>No</span>
                <% } %>
              </td>
              <td class="py-2 px-4 border">
                <% if (!assignment.verifiedByManager) { %>
                  <form method="POST" action="/manager/report/<%= assignment._id %>/verify" class="inline-block">
                    <button type="submit" class="bg-green-500 hover:bg-green-600 text-white px-3 py-1 rounded text-sm">
                      Verify
                    </button>
                  </form>
                <% } else { %>
                  <span class="text-gray-500 italic text-sm">Verified</span>
                <% } %>
                <a href="/manager/report/<%= assignment._id %>/detail"
                   class="inline-block ml-2 bg-blue-500 hover:bg-blue-600 text-white px-3 py-1 rounded text-sm">
                  Checklist Detail
                </a>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <div class="mt-6 flex justify-end space-x-4">
      <a href="/" class="text-blue-500 hover:text-blue-700">Home</a>
      <a href="/logout" class="text-blue-500 hover:text-blue-700">Logout</a>
    </div>
  </div>
</body>
</html>