<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manager Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="bg-gray-100">

<header class="bg-white shadow-sm sticky top-0 z-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
            <h1 class="text-xl font-bold text-gray-800">Manager Dashboard</h1>
            <a href="/logout" class="text-sm font-medium text-gray-600 hover:text-blue-600">Logout</a>
        </div>
    </div>
</header>

<div class="container mx-auto p-4 sm:p-6">
    <h1 class="text-3xl font-bold mb-6">Maintenance Reports</h1>

    <div class="bg-white p-4 rounded-lg shadow mb-6">
        <form method="GET" action="/manager/dashboard" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 items-end">
            <div>
                <label for="division_filter" class="block text-sm font-medium text-gray-700">Division</label>
                <select name="division" id="division_filter" onchange="this.form.submit()" class="mt-1 block w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm rounded-md">
                    <option value="all" <%= currentDivision === 'all' ? 'selected' : '' %>>All Divisions</option>
                    <% divisions.forEach(div => { %>
                    <option value="<%= div._id %>" <%= currentDivision === div._id.toString() ? 'selected' : '' %>><%= div.name %></option>
                    <% }) %>
                </select>
            </div>
            <div>
                <label for="status_filter" class="block text-sm font-medium text-gray-700">Status</label>
                <select name="filter" id="status_filter" onchange="this.form.submit()" class="mt-1 block w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm rounded-md">
                    <option value="all" <%= currentFilter === 'all' ? 'selected' : '' %>>All Reports</option>
                    <option value="verified_spv" <%= currentFilter === 'verified_spv' ? 'selected' : '' %>>Pending Your Approval</option>
                    <option value="verified_manager" <%= currentFilter === 'verified_manager' ? 'selected' : '' %>>Approved by You</option>
                    <option value="has_alert" <%= currentFilter === 'has_alert' ? 'selected' : '' %>>With Alerts</option>
                    <option value="rejected" <%= currentFilter === 'rejected' ? 'selected' : '' %>>Rejected</option>
                </select>
            </div>
            <div>
                <label for="floor_filter" class="block text-sm font-medium text-gray-700">Floor</label>
                <select name="floor" id="floor_filter" onchange="this.form.submit()" class="mt-1 block w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm rounded-md">
                    <option value="all" <%= currentFloor === 'all' ? 'selected' : '' %>>All Floors</option>
                    <% floors.forEach(floor => { %>
                    <option value="<%= floor._id %>" <%= currentFloor === floor._id.toString() ? 'selected' : '' %>><%= floor.name %></option>
                    <% }) %>
                </select>
            </div>
             <div>
                <label for="submitted_by_filter" class="block text-sm font-medium text-gray-700">Technician</label>
                <select name="submittedBy" id="submitted_by_filter" onchange="this.form.submit()" class="mt-1 block w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm rounded-md">
                    <option value="all" <%= currentSubmittedBy === 'all' ? 'selected' : '' %>>All Technicians</option>
                    <% technicians.forEach(tech => { %>
                    <option value="<%= tech._id %>" <%= currentSubmittedBy === tech._id.toString() ? 'selected' : '' %>><%= tech.name %></option>
                    <% }) %>
                </select>
            </div>
        </form>
    </div>

    <div class="overflow-x-auto bg-white shadow-lg rounded-lg">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Asset & Checklist</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Submission</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
            <% if (assignments.length > 0) { %>
                <% assignments.forEach(assignment => { %>
                <tr id="assignment-row-<%= assignment._id %>" data-id="<%= assignment._id %>" class="hover:bg-gray-50 <%= assignment.verifiedStatus === 'rejected' ? 'bg-red-50' : '' %>">
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm font-medium text-gray-900"><%= assignment.assetSnapshot?.name || 'N/A' %></div>
                        <div class="text-sm text-gray-500"><%= assignment.checklistTitle || 'N/A' %></div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm text-gray-900"><%= assignment.submittedByName || 'N/A' %></div>
                        <div class="text-sm text-gray-500"><%= new Date(assignment.completedAt).toLocaleString() %></div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap status-cell">
                        <% if (assignment.verifiedStatus === 'rejected') { %>
                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">Rejected by <%= assignment.rejectedByName || 'N/A' %></span>
                        <% } else if (assignment.verifiedByManager) { %>
                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">Approved</span>
                        <% } else if (assignment.verifiedBySpv) { %>
                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-blue-100 text-blue-800">Pending Your Approval</span>
                        <% } else { %>
                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-gray-100 text-gray-800">Pending SPV</span>
                        <% } %>
                        <% if (assignment.hasAlert) { %>
                            <span class="px-2 ml-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-yellow-100 text-yellow-800">Alert</span>
                        <% } %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium action-cell">
                        <a href="/manager/report/<%= assignment._id %>/detail" class="text-indigo-600 hover:text-indigo-900 mr-4">Detail</a>
                        <% if (assignment.verifiedStatus !== 'rejected' && assignment.verifiedBySpv && !assignment.verifiedByManager) { %>
                            <button type="button" class="text-green-600 hover:text-green-900 verify-btn" data-id="<%= assignment._id %>">Verify</button>
                        <% } %>
                        <% if (assignment.verifiedStatus !== 'rejected') { %>
                            <button type="button" class="text-red-600 hover:text-red-900 reject-btn ml-2" data-id="<%= assignment._id %>" data-verified="<%= assignment.verifiedByManager ? 'true' : 'false' %>">Reject</button>
                        <% } %>
                    </td>
                </tr>
                <% }); %>
            <% } else { %>
                <tr>
                    <td colspan="4" class="px-6 py-12 text-center text-sm text-gray-500">No reports found for the selected filter.</td>
                </tr>
            <% } %>
            </tbody>
        </table>
    </div>

    <div class="mt-8 bg-white p-6 rounded-lg shadow-lg">
      <h2 class="text-xl font-bold mb-4">Recent System-Wide Activities</h2>
      <div class="h-64 overflow-y-auto">
        <% if (locals.activities && activities.length > 0) { %>
            <ul>
                <% activities.forEach(activity => { %>
                    <li class="border-b last:border-b-0 py-2">
                        <p class="text-sm text-gray-800">
                            <strong><%= activity.user.name %></strong> (<%= activity.role %>) <%= activity.action %>
                        </p>
                        <p class="text-xs text-gray-500">
                            <%= new Date(activity.timestamp).toLocaleString() %>
                            <% if (activity.division && activity.division.name) { %>
                                - Division: <%= activity.division.name %>
                            <% } %>
                        </p>
                    </li>
                <% }); %>
            </ul>
        <% } else { %>
            <p class="text-gray-500">No recent activities.</p>
        <% } %>
      </div>
    </div>
</div>

<div id="rejection-modal" class="fixed z-10 inset-0 overflow-y-auto hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
  </div>

<script>
    // JavaScript for modal and actions remains the same
</script>

</body>
</html>