<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Checklist Report Detail</title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="bg-gray-100">
  <div class="max-w-4xl mx-auto p-6 bg-white shadow-md rounded">
    <h1 class="text-2xl font-bold mb-4">Checklist Report Detail</h1>
    
    <!-- Report Header -->
    <div class="mb-4 space-y-2">
      <p><strong>Asset:</strong> <%= assignment.asset.name %></p>
      <p><strong>Checklist:</strong> <%= assignment.checklist ? assignment.checklist.title : 'N/A' %></p>
      <p>
        <strong>Submitted On:</strong>
        <%= new Date(assignment.completedAt).toLocaleDateString() %>
        at
        <%= new Date(assignment.completedAt).toLocaleTimeString() %>
      </p>
      <p><strong>Technician:</strong> <%= assignment.submittedBy ? assignment.submittedBy.name : 'N/A' %></p>

      <!-- Verification Statuses -->
      <p>
        <strong>Verified by SPV:</strong>
        <% if (assignment.verifiedBySpv) { %>
          <span class="text-blue-600 font-semibold">Yes</span>
        <% } else { %>
          <span class="text-yellow-600 font-semibold">No</span>
        <% } %>
      </p>
      <p>
        <strong>Verified by Manager:</strong>
        <% if (assignment.verifiedByManager) { %>
          <span class="text-green-600 font-semibold">Yes</span>
        <% } else { %>
          <span class="text-yellow-600 font-semibold">No</span>
        <% } %>
      </p>
    </div>

    <!-- Task Responses -->
    <h2 class="text-xl font-semibold mt-6 mb-4">Task Responses</h2>
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="bg-gray-200">
          <th class="p-2 border">Task Description</th>
          <th class="p-2 border">Response</th>
        </tr>
      </thead>
      <tbody>
        <% if (assignment.checklist && assignment.checklist.tasks) { %>
          <% assignment.checklist.tasks.forEach(function(task) {
               const response = assignment.responses[task._id];
          %>
            <tr class="border-b">
              <td class="p-2 border"><%= task.description %></td>
              <td class="p-2 border">
                <% if (Array.isArray(response)) { %>
                  <% if (response.length > 0) { %>
                    <% response.forEach(function(photo) { %>
                      <img src="/<%= photo %>" alt="Task Image"
                           class="w-20 h-20 object-cover inline-block mr-2 mb-2 rounded">
                    <% }); %>
                  <% } else { %>
                    No response provided
                  <% } %>
                <% } else { %>
                  <%= response || 'No response provided' %>
                <% } %>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td class="p-2 border" colspan="2">No tasks available.</td>
          </tr>
        <% } %>
      </tbody>
    </table>

    <!-- Maintenance Note -->
    <div class="mt-6">
      <h2 class="text-xl font-semibold mb-2">Maintenance Note</h2>
      <p class="text-gray-700"><%= assignment.note || "No note provided" %></p>
    </div>

    <!-- Navigation Links -->
    <div class="mt-6 flex justify-between">
      <a href="/technician/report" class="bg-gray-500 hover:bg-gray-600 text-white px-4 py-2 rounded">
        Back to Reports
      </a>
      <a href="/technician/dashboard" class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded">
        Dashboard
      </a>
    </div>
  </div>

  <!-- Desktop-Only Links -->
  <div class="max-w-4xl mx-auto mt-4 hidden sm:flex justify-end space-x-4">
    <a href="/technician/dashboard" class="text-blue-500 hover:text-blue-700">Dashboard</a>
    <a href="/logout" class="text-blue-500 hover:text-blue-700">Logout</a>
  </div>

  <!-- Mobile Bottom Nav -->
  <div class="fixed inset-x-0 bottom-0 bg-white border-t shadow sm:hidden">
    <div class="flex justify-around py-2">
      <a href="/technician/dashboard" class="flex flex-col items-center text-blue-500">
        <svg class="w-6 h-6 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M3 12l2-2m0 0l7-7 7 7M13 5v6h6"/>
        </svg>
        <span class="text-xs">Dashboard</span>
      </a>
      <a href="/technician/report" class="flex flex-col items-center text-blue-500">
        <svg class="w-6 h-6 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M9 17v-6a2 2 0 012-2h2a2 2 0 012 2v6m-6 0h6"/>
        </svg>
        <span class="text-xs">Reports</span>
      </a>
      <a href="/logout" class="flex flex-col items-center text-blue-500">
        <svg class="w-6 h-6 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M17 16l4-4m0 0l-4-4m4 4H7"/>
        </svg>
        <span class="text-xs">Logout</span>
      </a>
    </div>
  </div>

  <!-- GALLERY MODAL -->
  <div id="galleryModal" class="fixed inset-0 z-50 hidden items-center justify-center">
    <div class="absolute inset-0 bg-black bg-opacity-70" onclick="closeGallery()"></div>
    <div class="relative bg-white p-4 rounded max-w-4xl w-full mx-auto mt-10">
      <h2 class="text-xl font-bold mb-2">Images</h2>
      <div id="galleryGrid" class="grid grid-cols-3 md:grid-cols-4 gap-2"></div>
      <button class="mt-4 px-4 py-2 bg-gray-200 hover:bg-gray-300 rounded" onclick="closeGallery()">Close</button>
    </div>
  </div>

  <!-- ENLARGED MODAL -->
  <div id="enlargedModal" class="fixed inset-0 z-50 hidden items-center justify-center">
    <div class="absolute inset-0 bg-black bg-opacity-80" onclick="closeEnlarged()"></div>
    <img id="enlargedImg" class="relative max-h-[80vh] mx-auto mt-10 rounded shadow-lg" src="" alt="Enlarged">
  </div>

  <!-- Gallery Script -->
  <script>
    function parseImagesAttr(element) {
      const encodedJson = element.getAttribute('data-images');
      if (!encodedJson) return [];
      return JSON.parse(decodeURIComponent(encodedJson));
    }
    function openGalleryFromImg(imgEl) {
      const imgs = parseImagesAttr(imgEl);
      imgs.length === 1 ? enlargeImage('/' + imgs[0]) : openGallery(imgs);
    }
    function openGalleryFromDiv(divEl) {
      openGallery(parseImagesAttr(divEl));
    }
    function openGallery(images) {
      const modal = document.getElementById('galleryModal');
      const grid = document.getElementById('galleryGrid');
      grid.innerHTML = '';
      images.forEach(path => {
        const img = document.createElement('img');
        img.src = '/' + path;
        img.className = 'w-full h-32 object-cover cursor-pointer border border-gray-300';
        img.onclick = () => enlargeImage('/' + path);
        grid.appendChild(img);
      });
      modal.classList.remove('hidden'); modal.classList.add('flex');
    }
    function closeGallery() {
      const m = document.getElementById('galleryModal');
      m.classList.add('hidden'); m.classList.remove('flex');
    }
    function enlargeImage(url) {
      const m = document.getElementById('enlargedModal');
      const img = document.getElementById('enlargedImg');
      img.src = url;
      m.classList.remove('hidden'); m.classList.add('flex');
    }
    function closeEnlarged() {
      const m = document.getElementById('enlargedModal');
      m.classList.add('hidden'); m.classList.remove('flex');
    }
  </script>
</body>
</html>
