<!DOCTYPE html>
<html lang="en">
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta charset="UTF-8">
  <title>Checklist Report Detail</title>
  <!-- Tailwind CSS -->
  <link
    href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css"
    rel="stylesheet"
  />
</head>
<body class="bg-gray-100">
  <div class="max-w-4xl mx-auto p-6 bg-white shadow-md rounded">
    <h1 class="text-2xl font-bold mb-4">Checklist Report Detail</h1>
    
    <!-- Report Header -->
    <div class="mb-4">
      <p><strong>Asset:</strong> <%= assignment.asset.name %></p>
      <p><strong>Checklist:</strong> <%= assignment.checklist ? assignment.checklist.title : 'N/A' %></p>
      <p><strong>Submitted on:</strong> <%= new Date(assignment.completedAt).toLocaleDateString() %> at <%= new Date(assignment.completedAt).toLocaleTimeString() %></p>
      <p><strong>Technician:</strong> <%= assignment.submittedBy ? assignment.submittedBy.name : 'N/A' %></p>
      <p><strong>Verification Status:</strong> 
        <% if (assignment.verifiedStatus === 'verified') { %>
          <span class="text-green-600 font-bold">Verified</span>
        <% } else if (assignment.verifiedStatus === 'rejected') { %>
          <span class="text-red-600 font-bold">Rejected</span>
        <% } else { %>
          <span class="text-yellow-600 font-bold">Pending</span>
        <% } %>
      </p>
    </div>
    
    
    <!-- Task Responses -->
    <h2 class="text-xl font-semibold mt-6 mb-4">Task Responses</h2>
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="bg-gray-200">
          <th class="p-2 border">Task Description</th>
          <th class="p-2 border">Response</th>
        </tr>
      </thead>
      <tbody>
        <% if (assignment.checklist && assignment.checklist.tasks) { %>
          <% assignment.checklist.tasks.forEach(function(task) { 
               const response = assignment.responses[task._id];
          %>
            <tr class="border-b">
              <td class="p-2 border">
                <%= task.description %>
              </td>
              <td class="p-2 border">
                <% if (Array.isArray(response)) { %>
                  <% if (response.length === 0) { %>
                    No response provided
                  <% } else if (response.length === 1) { %>
                    <!-- Exactly one image -->
                    <img
                      src="/<%= response[0] %>"
                      alt="Task Image"
                      class="w-20 h-20 object-cover cursor-pointer"
                      data-images="<%= encodeURIComponent(JSON.stringify(response)) %>"
                      onclick="openGalleryFromImg(this)"
                    />
                  <% } else { %>
                    <!-- More than one image: show first + overlay -->
                    <div
                      class="relative inline-block cursor-pointer"
                      data-images="<%= encodeURIComponent(JSON.stringify(response)) %>"
                      onclick="openGalleryFromDiv(this)"
                    >
                      <img
                        src="/<%= response[0] %>"
                        alt="Task Image"
                        class="w-20 h-20 object-cover"
                      />
                      <div class="absolute inset-0 bg-gray-500 bg-opacity-20"></div>
                      <div
                        class="absolute bottom-0 right-0 text-white text-sm bg-black bg-opacity-70 px-2 py-1 rounded"
                      >
                        +<%= response.length - 1 %>
                      </div>
                    </div>
                  <% } %>
                <% } else { %>
                  <!-- Not an array => pass/fail or measurement -->
                  <%= response ? response : 'No response provided' %>
                <% } %>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td class="p-2 border" colspan="2">
              No checklist tasks available.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>

      <!-- Maintenance Note (displayed below the responses) -->
      <div class="mt-4">
        <h2 class="text-xl font-semibold mb-2">Maintenance Note</h2>
        <p class="text-gray-700"><%= assignment.note || "No note provided" %></p>
      </div>
    
    <!-- Back Link -->
    <div class="mt-6">
      <a
        href="/technician/report"
        class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded"
      >
        Back to Reports
      </a>
    </div>
  </div>
  
  <!-- DESKTOP-ONLY NAV LINKS -->
  <div class="max-w-4xl mx-auto mt-4 hidden sm:flex justify-end space-x-4">
    <a href="/technician/dashboard" class="text-blue-500 hover:text-blue-700">Dashboard</a>
    <a href="/logout" class="text-blue-500 hover:text-blue-700">Logout</a>
  </div>

  <!-- FIXED BOTTOM NAV FOR MOBILE -->
  <div class="fixed inset-x-0 bottom-0 bg-white border-t shadow sm:hidden">
    <div class="flex justify-around py-2">
      <!-- Dashboard -->
      <a href="/technician/dashboard" class="flex flex-col items-center text-blue-500">
        <svg class="w-6 h-6 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path 
            stroke-linecap="round" 
            stroke-linejoin="round" 
            stroke-width="2" 
            d="M3 12l2-2m0 0l7-7 7 7M13 5v6h6"
          ></path>
        </svg>
        <span class="text-xs">Dashboard</span>
      </a>
      <!-- Reports -->
      <a href="/technician/report" class="flex flex-col items-center text-blue-500">
        <svg class="w-6 h-6 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path 
            stroke-linecap="round" 
            stroke-linejoin="round" 
            stroke-width="2" 
            d="M9 17v-6a2 2 0 012-2h2a2 2 0 012 2v6m-6 0h6"
          ></path>
        </svg>
        <span class="text-xs">Reports</span>
      </a>
      <!-- Logout -->
      <a href="/logout" class="flex flex-col items-center text-blue-500">
        <svg class="w-6 h-6 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path 
            stroke-linecap="round" 
            stroke-linejoin="round" 
            stroke-width="2" 
            d="M17 16l4-4m0 0l-4-4m4 4H7"
          ></path>
        </svg>
        <span class="text-xs">Logout</span>
      </a>
    </div>
  </div>

  <!-- GALLERY MODAL: shows all images in a grid -->
  <div
    id="galleryModal"
    class="fixed inset-0 z-50 hidden items-center justify-center"
  >
    <!-- Backdrop -->
    <div
      class="absolute inset-0 bg-black bg-opacity-70"
      onclick="closeGallery()"
    ></div>
    
    <!-- Modal content -->
    <div
      class="relative bg-white p-4 rounded max-w-4xl w-full mx-auto mt-10"
    >
      <h2 class="text-xl font-bold mb-2">Images</h2>
      <!-- Grid container for images -->
      <div
        id="galleryGrid"
        class="grid grid-cols-3 md:grid-cols-4 gap-2"
      >
        <!-- Filled via JS -->
      </div>
      <button
        class="mt-4 px-4 py-2 bg-gray-200 hover:bg-gray-300 rounded"
        onclick="closeGallery()"
      >
        Close
      </button>
    </div>
  </div>

  <!-- ENLARGED MODAL: single big image -->
  <div
    id="enlargedModal"
    class="fixed inset-0 z-50 hidden items-center justify-center"
  >
    <!-- Dark backdrop -->
    <div
      class="absolute inset-0 bg-black bg-opacity-80"
      onclick="closeEnlarged()"
    ></div>
    <!-- The enlarged image -->
    <img
      id="enlargedImg"
      class="relative max-h-[80vh] mx-auto mt-10 rounded shadow-lg"
      src=""
      alt="Enlarged"
    />
  </div>

  <!-- JavaScript to handle the gallery modals -->
  <script>
    /**
     * Helper to parse the data-images attribute (encoded JSON).
     */
    function parseImagesAttr(element) {
      const encodedJson = element.getAttribute('data-images');
      if (!encodedJson) return [];
      const decoded = decodeURIComponent(encodedJson);
      return JSON.parse(decoded);
    }

    /**
     * Called by a single image's onclick.
     */
    function openGalleryFromImg(imgElement) {
      const images = parseImagesAttr(imgElement);
      // If there's only 1 image, just enlarge it
      if (images.length === 1) {
        enlargeImage('/' + images[0]);
      } else {
        openGallery(images);
      }
    }

    /**
     * Called by the "stacked" image div's onclick (multiple images).
     */
    function openGalleryFromDiv(divElement) {
      const images = parseImagesAttr(divElement);
      openGallery(images);
    }

    /**
     * Opens the gallery modal, displaying all images in a grid.
     * @param {string[]} images Array of image paths
     */
    function openGallery(images) {
      const galleryModal = document.getElementById('galleryModal');
      const galleryGrid = document.getElementById('galleryGrid');
      
      // Clear any old content
      galleryGrid.innerHTML = '';
      
      // Create a thumbnail for each image
      images.forEach(imgPath => {
        const img = document.createElement('img');
        img.src = `/${imgPath}`;
        img.classList.add(
          'w-full',
          'h-32',
          'object-cover',
          'cursor-pointer',
          'border',
          'border-gray-300'
        );
        // Clicking a thumbnail enlarges the image
        img.onclick = () => enlargeImage(`/${imgPath}`);
        galleryGrid.appendChild(img);
      });
      
      // Show the gallery modal
      galleryModal.classList.remove('hidden');
      galleryModal.classList.add('flex');
    }

    /**
     * Closes the gallery modal.
     */
    function closeGallery() {
      const galleryModal = document.getElementById('galleryModal');
      galleryModal.classList.add('hidden');
      galleryModal.classList.remove('flex');
    }

    /**
     * Opens the enlarged modal with a single big image.
     */
    function enlargeImage(imgUrl) {
      const enlargedModal = document.getElementById('enlargedModal');
      const enlargedImg = document.getElementById('enlargedImg');
      enlargedImg.src = imgUrl;
      enlargedModal.classList.remove('hidden');
      enlargedModal.classList.add('flex');
    }

    /**
     * Closes the enlarged image modal.
     */
    function closeEnlarged() {
      const enlargedModal = document.getElementById('enlargedModal');
      enlargedModal.classList.add('hidden');
      enlargedModal.classList.remove('flex');
    }
  </script>
</body>
</html>
