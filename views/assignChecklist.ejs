<!DOCTYPE html>
<html lang="en">
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta charset="UTF-8">
  <title>Assign Checklist</title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
  <style>
    /* Ensure sticky headers work correctly */
    .sticky-header {
      position: -webkit-sticky;
      position: sticky;
      top: 0;
      z-index: 10;
    }
  </style>
</head>
<body class="bg-gray-100">
  <div class="max-w-7xl mx-auto mt-8 p-4 bg-white shadow-md rounded">
    <h1 class="text-xl font-bold mb-4">Assign Checklist</h1>
    <p class="mb-4">
      Checklist: <strong><%= checklist.title %></strong>
    </p>
    
    <form action="/spv/checklists/<%= checklist._id %>/assign" method="POST">
      <h2 class="text-md font-semibold mb-2">Pilih Asset (hanya asset divisi Anda):</h2>
      <div class="mb-4 h-[60vh] overflow-auto border rounded-md p-2">
        <% Object.keys(assetsByHierarchy).sort().forEach(categoryName => { %>
          <div class="mb-6">
            <h3 class="text-lg font-bold my-2 p-2 bg-gray-200 rounded-md sticky-header flex items-center">
              <input type="checkbox" class="mr-2 h-5 w-5 text-blue-600 border-gray-300 rounded focus:ring-blue-500" onclick="toggleCategory(this, '<%= categoryName %>')">
              <%= categoryName %>
            </h3>
            <% Object.keys(assetsByHierarchy[categoryName]).sort().forEach(floorName => { %>
              <div class="mb-4 pl-4">
                <h4 class="font-semibold text-md my-2 p-2 bg-gray-100 rounded-md sticky-header"><%= floorName %></h4>
                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
                  <% Object.keys(assetsByHierarchy[categoryName][floorName]).sort().forEach(zoneName => { %>
                    <div>
                      <h5 class="font-bold text-sm text-center bg-blue-100 text-blue-800 rounded-t-md py-1"><%= zoneName %></h5>
                      <div class="border rounded-b-md p-2">
                        <% assetsByHierarchy[categoryName][floorName][zoneName].forEach(asset => { %>
                          <div class="flex items-center mb-1 asset-checkbox-container" data-category="<%= categoryName %>">
                            <input
                              type="checkbox"
                              name="assetIds"
                              value="<%= asset._id %>"
                              id="asset-<%= asset._id %>"
                              class="mr-2 h-4 w-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500"
                              <%= assignedAssetIds.includes(asset._id.toString()) ? 'checked' : '' %>
                            />
                            <label for="asset-<%= asset._id %>" class="w-full cursor-pointer text-sm">
                              <%= asset.name %>
                            </label>
                          </div>
                        <% }); %>
                      </div>
                    </div>
                  <% }); %>
                </div>
              </div>
            <% }); %>
          </div>
        <% }); %>
      </div>
      <div class="flex items-center justify-end space-x-4">
        <a href="/spv/dashboard" class="text-gray-600 hover:text-gray-800">
          Batal
        </a>
        <button
          type="submit"
          class="bg-blue-600 hover:bg-blue-700 text-white font-bold px-4 py-2 rounded shadow-sm transition duration-200"
        >
          Simpan Assignment
        </button>
      </div>
    </form>
  </div>

  <script>
    function toggleCategory(checkbox, categoryName) {
      const isChecked = checkbox.checked;
      const assetCheckboxes = document.querySelectorAll(`.asset-checkbox-container[data-category="${categoryName}"] input[type="checkbox"]`);
      assetCheckboxes.forEach(box => {
        box.checked = isChecked;
      });
    }
  </script>

</body>
</html>