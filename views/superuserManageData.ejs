<!DOCTYPE html>
<html>
<head>
  <title>Manage Data</title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="bg-gray-100">
  <div class="container mx-auto p-6">
    <h1 class="text-3xl font-bold mb-6">Manage Master Data</h1>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      
      <a href="/admin/divisions" class="bg-white p-6 rounded-lg shadow hover:shadow-lg transition-shadow">
        <h2 class="text-xl font-semibold">Manage Divisions</h2>
        <p class="text-gray-600 mt-2">Add, edit, or remove operational divisions.</p>
      </a>

      <a href="/admin/asset-categories" class="bg-white p-6 rounded-lg shadow hover:shadow-lg transition-shadow">
        <h2 class="text-xl font-semibold">Manage Asset Categories</h2>
        <p class="text-gray-600 mt-2">Organize assets by their category or type.</p>
      </a>

      <a href="/admin/floors-zones" class="bg-white p-6 rounded-lg shadow hover:shadow-lg transition-shadow">
        <h2 class="text-xl font-semibold">Manage Floors & Zones</h2>
        <p class="text-gray-600 mt-2">Define the physical layout of the building.</p>
      </a>

    </div>
    <div class="mt-8">
        <a href="/superuser/dashboard" class="text-indigo-600 hover:text-indigo-900">&larr; Back to Superuser Dashboard</a>
    </div>
  </div>
</body>
</html>