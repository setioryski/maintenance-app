<!DOCTYPE html>
<html lang="en">
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta charset="UTF-8">
  <title>Asset Detail</title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="bg-gray-100">

  <header class="bg-white shadow-sm sticky top-0 z-10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center h-16">
        <h1 class="text-xl font-bold text-gray-800">Asset Detail</h1>
        <a href="/technician/dashboard" class="text-sm font-medium text-gray-600 hover:text-blue-600">Back to Dashboard</a>
      </div>
    </div>
  </header>

  <div class="max-w-6xl mx-auto p-4">
    <div class="bg-white rounded-lg shadow p-6">
      <h2 class="text-2xl font-bold text-gray-800 mb-2"><%= asset.name %></h2>
      <p class="text-sm text-gray-500 mb-4">
          Fl. <%= asset.floor?.name || 'N/A' %> / Zone <%= asset.zone?.name || 'N/A' %> / <%= asset.location %>
      </p>
      <p class="text-gray-700 mb-6"><%= asset.description %></p>

      <h3 class="text-xl font-bold text-gray-800 mb-4">Assigned Checklists</h3>
      <% if (assignments.length > 0) { %>
        <div class="space-y-4">
          <% assignments.forEach(assignment => { %>
            <div class="flex justify-between items-center p-4 border rounded-md hover:bg-gray-50">
              <p class="font-semibold text-gray-800"><%= assignment.checklist.title %></p>
              <a href="/technician/checklist/<%= assignment._id %>" class="text-center text-sm px-4 py-2 bg-blue-100 hover:bg-blue-200 text-blue-800 font-semibold rounded-lg transition">
                Start Checklist
              </a>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <p class="text-gray-500">No checklists assigned to this asset.</p>
      <% } %>
    </div>
  </div>

</body>
</html>