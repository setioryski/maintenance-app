<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checklist Report Detail</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="bg-gray-100">
<div class="max-w-4xl mx-auto mt-8 p-6 bg-white shadow-lg rounded-lg">
    <h1 class="text-2xl font-bold mb-4 border-b pb-4">Checklist Report Detail</h1>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
        <div>
            <p><strong>Asset:</strong> <%= assignment.asset.name %></p>
            <p><strong>Checklist:</strong> <%= assignment.checklist.title %></p>
            <p><strong>Submitted By:</strong> <%= assignment.submittedBy.name %></p>
            <p><strong>Submitted At:</strong> <%= new Date(assignment.completedAt).toLocaleString() %></p>
        </div>
        <div>
            <p><strong>SPV Verification:</strong> 
                <% if (assignment.verifiedBySpv) { %>
                    Verified by <%= assignment.verifiedBySpvUser?.name || 'N/A' %>
                <% } else { %>
                    No
                <% } %>
            </p>
            <p><strong>Manager Verification:</strong> 
                <% if (assignment.verifiedByManager) { %>
                    Verified by <%= assignment.verifiedByManagerUser?.name || 'N/A' %>
                <% } else { %>
                    No
                <% } %>
            </p>
            <p><strong>Status:</strong>
                <% if (assignment.verifiedStatus === 'rejected') { %>
                    <span class="font-bold text-red-600">Rejected by <%= assignment.rejectedBy?.name || 'N/A' %></span>
                <% } else if (assignment.hasAlert) { %>
                     <span class="font-bold text-yellow-600">Pending with Alert</span>
                <% } else { %>
                     <span class="font-bold text-green-600">OK</span>
                <% } %>
            </p>
        </div>
    </div>

    <h2 class="text-xl font-semibold mb-4">Task Responses</h2>
    <div class="space-y-4">
        <% assignment.tasksSnapshot.forEach(task => { %>
            <div class="p-4 border rounded-md bg-gray-50">
                <p class="font-semibold"><%= task.description %></p>
                <p class="text-sm text-gray-600">Type: <%= task.inputType %></p>
                <% const response = assignment.responses[task.originalTaskId.toString()]; %>
                <div class="mt-2">
                    <strong>Response:</strong>
                    <% if (Array.isArray(response)) { %>
                        <div class="flex flex-wrap gap-2 mt-2">
                            <% response.forEach(url => { %>
                                <a href="<%= url %>" target="_blank"><img src="<%= url %>" class="w-24 h-24 object-cover rounded"></a>
                            <% }); %>
                        </div>
                    <% } else { %>
                        <span class="font-mono bg-gray-200 px-2 py-1 rounded"><%= response || 'N/A' %></span>
                    <% } %>
                </div>
            </div>
        <% }); %>
    </div>
    
    <% if (assignment.note) { %>
        <h2 class="text-xl font-semibold mt-6 mb-2">Maintenance Note</h2>
        <p class="p-4 border rounded-md bg-gray-50"><%= assignment.note %></p>
    <% } %>

    <div class="mt-8 flex justify-between items-center">
        <div>
             <% if (assignment.verifiedStatus !== 'rejected' && !assignment.verifiedByManager) { %>
                <form method="POST" action="/spv/report/<%= assignment._id %>/verify" class="inline">
                    <button type="submit" class="bg-green-600 text-white px-4 py-2 rounded-md hover:bg-green-700" <%= assignment.verifiedBySpv ? 'disabled' : '' %>>Verify</button>
                </form>
                 <form method="POST" action="/spv/report/<%= assignment._id %>/reject" class="inline ml-2">
                    <button type="submit" class="bg-red-600 text-white px-4 py-2 rounded-md hover:bg-red-700">Reject</button>
                </form>
            <% } %>
        </div>
        <div>
            <a href="/spv/report" class="bg-gray-500 text-white px-4 py-2 rounded-md hover:bg-gray-600">Back to Reports</a>
        </div>
    </div>
</div>
</body>
</html>
