<!DOCTYPE html>
<html lang="en">
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta charset="UTF-8">
  <title>Edit Checklist</title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
  <script>
    function toggleMeasurementFields(selectElem, rowElem) {
      const measurementContainer = rowElem.querySelector('.measurement-container');
      if (selectElem.value === 'measurement') {
        measurementContainer.classList.remove('hidden');
      } else {
        measurementContainer.classList.add('hidden');
        // Clear values when hiding
        rowElem.querySelector('input[name="taskMinRanges"]').value = '';
        rowElem.querySelector('input[name="taskMaxRanges"]').value = '';
        rowElem.querySelector('input[name="taskExpectedUnits"]').value = '';
      }
    }
    
    function removeTask(button) {
      const row = button.closest('.task-row');
      row.remove();
    }

    function createTaskRow(task = {}) {
      const desc = task.description || '';
      const type = task.inputType || 'functional';
      const expUnit = task.expectedUnit || '';
      const minRange = task.minRange || '';
      const maxRange = task.maxRange || '';

      const row = document.createElement('div');
      row.className = "task-row flex flex-col sm:flex-row items-start sm:items-center gap-2 mb-2";
      row.innerHTML = `
        <input type="text" name="taskDescriptions" placeholder="Masukkan item inspeksi" class="flex-1 border border-gray-300 rounded p-2" value="${desc}" required />
        <select name="taskInputTypes" class="border border-gray-300 rounded p-2" required>
          <option value="functional" ${type === 'functional' ? 'selected' : ''}>Functional Test</option>
          <option value="measurement" ${type === 'measurement' ? 'selected' : ''}>Measurement</option>
        </select>
        <div class="measurement-container flex items-center gap-2 ${type === 'measurement' ? '' : 'hidden'}">
            <input type="number" name="taskMinRanges" placeholder="Min" class="border border-gray-300 rounded p-2 w-20" value="${minRange}" />
            <input type="number" name="taskMaxRanges" placeholder="Max" class="border border-gray-300 rounded p-2 w-20" value="${maxRange}" />
            <input type="text" name="taskExpectedUnits" placeholder="Unit" class="border border-gray-300 rounded p-2 w-24" value="${expUnit}" />
        </div>
        <button type="button" class="bg-red-500 text-white px-3 py-2 rounded" onclick="removeTask(this)">Hapus</button>
      `;
      const selectElem = row.querySelector('select[name="taskInputTypes"]');
      selectElem.addEventListener('change', () => toggleMeasurementFields(selectElem, row));
      return row;
    }

    function addTask() {
      const taskList = document.getElementById('taskList');
      const row = createTaskRow();
      taskList.appendChild(row);
    }
  </script>
</head>
<body class="bg-gray-100">
  <div class="max-w-4xl mx-auto mt-8 p-6 bg-white shadow-md rounded">
    <h1 class="text-xl font-bold mb-6">Edit Checklist</h1>
    <form action="/checklists/<%= checklist._id %>/edit" method="POST">
      <div class="mb-4">
        <label class="block text-gray-700 font-semibold mb-1">Nama Checklist</label>
        <input type="text" name="title" class="w-full border border-gray-300 rounded p-2" value="<%= checklist.title %>" required />
      </div>

      <div class="flex items-center justify-between mb-2">
        <label class="text-gray-700 font-semibold">Item Inspeksi</label>
        <button type="button" class="bg-green-500 text-white px-4 py-2 rounded" onclick="addTask()">+ Tambah Item</button>
      </div>

      <div id="taskList" class="mb-4">
        <% checklist.tasks.forEach(function(task) { %>
          <div class="task-row flex flex-col sm:flex-row items-start sm:items-center gap-2 mb-2">
            <input type="text" name="taskDescriptions" placeholder="Masukkan item inspeksi" class="flex-1 border border-gray-300 rounded p-2" value="<%= task.description %>" required />
            <select name="taskInputTypes" class="border border-gray-300 rounded p-2" required onchange="toggleMeasurementFields(this, this.closest('.task-row'))">
              <option value="measurement" <%= task.inputType === 'measurement' ? 'selected' : '' %>>Measurement</option>
              <option value="functional" <%= task.inputType === 'functional' ? 'selected' : '' %>>Functional Test</option>
            </select>
            <div class="measurement-container flex items-center gap-2 <%= task.inputType === 'measurement' ? '' : 'hidden' %>">
                <input type="number" name="taskMinRanges" placeholder="Min" class="border border-gray-300 rounded p-2 w-20" value="<%= task.minRange || '' %>" />
                <input type="number" name="taskMaxRanges" placeholder="Max" class="border border-gray-300 rounded p-2 w-20" value="<%= task.maxRange || '' %>" />
                <input type="text" name="taskExpectedUnits" placeholder="Unit" class="border border-gray-300 rounded p-2 w-24" value="<%= task.expectedUnit || '' %>" />
            </div>
            <button type="button" class="bg-red-500 text-white px-3 py-2 rounded" onclick="removeTask(this)">Hapus</button>
          </div>
        <% }); %>
      </div>

      <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded">Update Checklist</button>
    </form>

    <div class="mt-4 text-center">
      <a href="/spv/dashboard" class="bg-gray-500 hover:bg-gray-600 text-white px-4 py-2 rounded inline-block">
        Back to Dashboard
      </a>
    </div>
  </div>
</body>
</html>