<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Technician Reports</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css">
    <style>
        body {
            background-color: #f8f9fa;
        }
        .table-responsive {
            margin-top: 20px;
        }
        .status-badge {
            font-size: 0.9em;
        }
    </style>
</head>
<body>
    <div class="container-fluid mt-4">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3>My Completed Reports</h3>
                <a href="/technician/dashboard" class="btn btn-secondary">Back to Dashboard</a>
            </div>
            <div class="card-body">
                <p>This page shows all the maintenance checklists you have completed. You can view the details for each report.</p>

                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Checklist Title</th>
                                <th>Asset Name</th>
                                <th>Asset Category</th>
                                <th>Completed At</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (assignments.length > 0) { %>
                                <% assignments.forEach(assignment => { %>
                                    <tr>
                                        <td><%= assignment.checklist.title %></td>
                                        <td><%= assignment.asset.name %></td>
                                        <td><%= assignment.asset.category.name %></td>
                                        <td><%= new Date(assignment.completedAt).toLocaleDateString('en-US') %></td>
                                        <td>
                                            <% if (assignment.verifiedStatus === 'rejected') { %>
                                                <span class="badge bg-danger status-badge">Rejected</span>
                                            <% } else if (assignment.verifiedByManager) { %>
                                                <span class="badge bg-success status-badge">Verified</span>
                                            <% } else if (assignment.verifiedBySpv) { %>
                                                <span class="badge bg-primary status-badge">Verified by SPV</span>
                                            <% } else { %>
                                                <span class="badge bg-warning text-dark status-badge">Pending</span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <a href="/technician/report/<%= assignment._id %>" class="btn btn-sm btn-info" title="View Details">
                                                <i class="bi bi-eye"></i> View
                                            </a>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr>
                                    <td colspan="6" class="text-center">No completed reports found.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</body>
</html>