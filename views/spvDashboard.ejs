<!DOCTYPE html>
<html lang="en">
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta charset="UTF-8">
  <title>SPV Dashboard - Maintenance App</title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
  <style>
    .cursor-move { cursor: move; }
    .dragging { opacity: 0.5; background-color: #eef2ff; }
  </style>
</head>
<body class="bg-gray-100">
  <header class="bg-white shadow-md z-10 sticky top-0">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center h-16">
        <div class="flex-shrink-0">
          <img src="/image/logo.png" alt="Company Logo" class="h-8">
        </div>
        <div class="hidden md:block">
          <div class="ml-10 flex items-baseline space-x-4">
            <a href="/spv/dashboard" class="bg-blue-600 text-white px-3 py-2 rounded-md text-sm font-medium">Dashboard</a>
            <a href="/spv/report" class="text-gray-500 hover:bg-gray-200 hover:text-gray-900 px-3 py-2 rounded-md text-sm font-medium">Reports</a>
            <a href="/logout" class="text-gray-500 hover:bg-gray-200 hover:text-gray-900 px-3 py-2 rounded-md text-sm font-medium">Logout</a>
          </div>
        </div>
        <div class="md:hidden">
          <a href="/logout" class="text-gray-500 text-sm">Logout</a>
        </div>
      </div>
    </div>
  </header>
  
  <main class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
    <div class="px-4 py-6 sm:px-0">
        <% if (message && message.text) { %>
          <div class="p-4 mb-4 text-sm rounded-lg <%= message.type === 'success' ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700' %>" role="alert">
            <%= message.text %>
          </div>
        <% } %>

        <div class="flex flex-col md:flex-row items-start justify-between mb-6">
          <div>
            <h1 class="text-3xl font-bold text-gray-900">Dashboard Supervisor</h1>
            <p class="text-sm text-gray-500">Manage checklists, assets, and view recent activity.</p>
          </div>
          <div class="flex space-x-2 mt-4 md:mt-0">
            <% /* --- CORRECTED LINKS --- */ %>
            <a href="/spv/checklists/new" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded-lg shadow-sm flex items-center">
               <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
              New Checklist
            </a>
            <a href="/spv/assets/new" class="bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-4 rounded-lg shadow-sm flex items-center">
               <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"></path></svg>
              New Asset
            </a>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      
     <div class="bg-white p-6 rounded-lg shadow-lg">
            <h2 class="text-xl font-bold mb-4">Checklist Management</h2>
            <div class="hidden md:block">
              <table class="w-full text-left table-auto">
                <thead>
                  <tr class="bg-gray-50">
          
           <th class="p-3 border-b text-sm font-semibold text-gray-600">Checklist Name</th>
                    <th class="p-3 border-b text-sm font-semibold text-gray-600">Assigned Assets</th>
                    <th class="p-3 border-b text-sm font-semibold text-gray-600">Actions</th>
                  </tr>
               
  </thead>
                <tbody id="checklist-tbody">
                   <% checklists.forEach(checklist => { %>
                    <tr data-id="<%= checklist._id %>" class="cursor-move hover:bg-gray-50">
                      <td class="p-3 border-b border-gray-200"><%= checklist.title %></td>
       
               <td class="p-3 border-b border-gray-200"><%= checklist.assignmentCount || 0 %></td>
                      <td class="p-3 border-b border-gray-200">
                        <div class="flex gap-2">
                          <% /* --- CORRECTED LINKS --- */ %>
               
           <a href="/spv/checklists/<%= checklist._id %>/edit" class="text-yellow-600 hover:text-yellow-800">Edit</a>
                          <a href="/spv/checklists/<%= checklist._id %>/assign" class="text-green-600 hover:text-green-800">Assign</a>
                          <a href="/spv/checklists/<%= checklist._id %>/delete" class="text-red-600 hover:text-red-800" onclick="return confirm('Are you sure you want to delete this checklist?')">Delete</a>
            
             </div>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
            <div class="md:hidden space-y-3">
               <% checklists.forEach(checklist => { %>
                 <div class="border rounded-lg p-4 bg-gray-50">
    
               <p class="font-bold text-gray-800"><%= checklist.title %></p>
                   <p class="text-sm text-gray-600 mt-1">Assigned Assets: <%= checklist.assignmentCount || 0 %></p>
                   <div class="flex gap-2 mt-3">
                     <% /* --- CORRECTED LINKS --- */ %>
   
                   <a href="/spv/checklists/<%= checklist._id %>/edit" class="flex-1 text-center bg-yellow-500 hover:bg-yellow-600 text-white px-3 py-1 rounded text-sm">Edit</a>
                     <a href="/spv/checklists/<%= checklist._id %>/assign" class="flex-1 text-center bg-green-500 hover:bg-green-600 text-white px-3 py-1 rounded text-sm">Assign</a>
                     <a href="/spv/checklists/<%= checklist._id %>/delete" class="flex-1 text-center bg-red-500 hover:bg-red-600 text-white px-3 py-1 rounded text-sm" onclick="return confirm('Are you sure you want to delete this checklist?')">Delete</a>
                   </div>
                 </div>
               <% }); %>
             </div>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-lg">
            <h2 class="text-xl font-bold mb-4">Asset Management</h2>
            <div class="mb-4 grid grid-cols-1 sm:grid-cols-2 gap-4">
              <input type="text" id="asset-search" class="col-span-1 sm:col-span-2 border border-gray-300 rounded-md p-2 focus:ring-blue-500 focus:border-blue-500" placeholder="Search asset name...">
   
           <select id="asset-floor-filter" class="border border-gray-300 rounded-md p-2 focus:ring-blue-500 focus:border-blue-500">
                <option value="all">All Floors</option>
                <% floors.forEach(function(floor) { %><option value="<%= floor.name.toLowerCase() %>"><%= floor.name %></option><% }); %>
              </select>
              <select id="asset-category-filter" class="border border-gray-300 rounded-md p-2 focus:ring-blue-500 focus:border-blue-500">
                <option value="all">All Categories</option>
                <% assetCategories.forEach(function(cat) { %><option value="<%= cat._id %>"><%= cat.name %></option><% }); %>
              </select>
            </div>
            
            <div class="hidden md:block h-96 overflow-y-auto">
              <table class="w-full text-left table-auto">
                <thead>
             
     <tr class="bg-gray-50">
                    <th class="p-3 border-b text-sm font-semibold text-gray-600 sticky top-0 bg-gray-50">Asset Name</th>
                    <th class="p-3 border-b text-sm font-semibold text-gray-600 sticky top-0 bg-gray-50">Category</th>
                    <th class="p-3 border-b text-sm font-semibold text-gray-600 sticky top-0 bg-gray-50">Actions</th>
         
          </tr>
                </thead>
                <tbody id="asset-tbody">
                  <% assets.forEach(asset => { %>
                    <tr class="asset-item cursor-move hover:bg-gray-50" data-id="<%= asset._id %>" data-name="<%= asset.name.toLowerCase() %>" data-category="<%= asset.category ? asset.category._id.toString() : '' %>" data-floor="<%= asset.floor && asset.floor.name ? asset.floor.name.toLowerCase() : '' %>">
                      <td class="p-3 border-b border-gray-200">
                        <div class="font-medium text-gray-900"><%= asset.name %></div>
                        <div class="text-xs text-gray-500"><%= asset.location %>, Fl. <%= asset.floor ? asset.floor.name : 'N/A' %>, Zone <%= asset.zone ? asset.zone.name : 'N/A' %></div>
                      </td>
                      <td class="p-3 border-b border-gray-200"><%= asset.category ? asset.category.name : 'N/A' %></td>
                      <td class="p-3 border-b border-gray-200">
                
         <div class="flex gap-2">
                          <% /* --- CORRECTED LINKS AND FORM ACTIONS --- */ %>
                          <a href="/spv/assets/<%= asset._id %>/edit" class="text-yellow-600 hover:text-yellow-800">Edit</a>
                       
   <a href="/spv/assets/<%= asset._id %>/delete" class="text-red-600 hover:text-red-800" onclick="return confirm('Are you sure you want to delete this asset?')">Delete</a>
                          <a href="/spv/asset/<%= asset._id %>/qr" class="text-blue-600 hover:text-blue-800" target="_blank">QR</a>
                           <form action="/spv/assets/<%= asset._id %>/duplicate" method="POST" class="inline"><button type="submit" class="text-blue-600 hover:text-blue-800">Duplicate</button></form>
               
         </div>
                      </td>
                    </tr>
                   <% }); %>
                </tbody>
              </table>
            </div>

            <div id="asset-card-container" class="md:hidden space-y-3 h-96 overflow-y-auto">
              <% assets.forEach(asset => { %>
                <div class="asset-item border rounded-lg p-4 bg-gray-50" data-id="<%= asset._id %>" data-name="<%= asset.name.toLowerCase() %>" data-category="<%= asset.category ? asset.category._id.toString() : '' %>" data-floor="<%= asset.floor && asset.floor.name ? asset.floor.name.toLowerCase() : '' %>">
                    <p class="font-bold text-gray-800"><%= asset.name %></p>
                    <p class="text-sm text-gray-600"><%= asset.category ? asset.category.name : 'N/A' %></p>
                    <p class="text-sm text-gray-600"><%= asset.location %>, Floor <%= asset.floor ? asset.floor.name : 'N/A' %>, Zone <%= asset.zone ? asset.zone.name : 'N/A' %></p>
                    <div class="flex gap-2 mt-3">
                        <% /* --- CORRECTED LINKS AND FORM ACTIONS --- */ %>
                        <a href="/spv/assets/<%= asset._id %>/edit" class="flex-1 text-center bg-yellow-500 hover:bg-yellow-600 text-white px-3 py-1 rounded text-sm">Edit</a>
                        <a href="/spv/assets/<%= asset._id %>/delete" class="flex-1 text-center bg-red-500 hover:bg-red-600 text-white px-3 py-1 rounded text-sm" onclick="return confirm('Are you sure you want to delete this asset?')">Delete</a>
                        <a href="/spv/asset/<%= asset._id %>/qr" class="flex-1 text-center bg-blue-500 hover:bg-blue-600 text-white px-3 py-1 rounded text-sm" target="_blank">QR</a>
            
             <form action="/spv/assets/<%= asset._id %>/duplicate" method="POST" class="flex-1">
                          <button type="submit" class="w-full bg-blue-500 hover:bg-blue-600 text-white px-3 py-1 rounded text-sm">Duplicate</button>
                         </form>
                    </div>
   
             </div>
              <% }); %>
            </div>
            
            <% if (assets.length > 0 && totalPages > 1) { %>
                <div class="px-6 py-4 bg-white border-t flex flex-col xs:flex-row items-center xs:justify-between">
                    <span class="text-xs xs:text-sm text-gray-700">
                        Showing <%= Math.min(((currentPage - 1) * limit) + 1, totalAssets) %> to <%= Math.min(currentPage * limit, totalAssets) %> of <%= totalAssets %> Assets
                    </span>
                    <div class="inline-flex mt-2 xs:mt-0">
                        <% if (currentPage > 1) { %>
                            <a href="/spv/dashboard?page=<%= currentPage - 1 %>" class="text-sm bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-2 px-4 rounded-l">
                                Prev
                            </a>
                        <% } %>
                        <% if (currentPage < totalPages) { %>
                            <a href="/spv/dashboard?page=<%= currentPage + 1 %>" class="text-sm bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-2 px-4 rounded-r">
                                Next
                            </a>
                        <% } %>
                    </div>
                </div>
            <% } %>
          </div>
        </div>

        <div class="mt-8 bg-white p-6 rounded-lg shadow-lg">
          <h2 class="text-xl font-bold mb-4">Recent Activities</h2>
          <div class="h-64 overflow-y-auto">
            <ul>
              <% if (locals.activities && activities.length > 0) { %>
                <% activities.forEach(function(activity) { %>
                  <li class="border-b last:border-b-0 py-3">
                    <p class="text-sm text-gray-800">
                      <strong><%= activity.user.name || (activity.user.id && activity.user.id.name) || 'N/A' %></strong> (<%= activity.role %>) <%= activity.action %>
                    </p>
                    <p class="text-xs text-gray-500 mt-1"><%= new Date(activity.timestamp).toLocaleString() %></p>
                  </li>
                <% }); %>
              <% } else { %>
                <p class="text-gray-500">No recent activities in your division.</p>
              <% } %>
            </ul>
          </div>
        </div>
    </div>
  </main>

  <div class="fixed inset-x-0 bottom-0 bg-white border-t shadow-lg md:hidden">
    <div class="flex justify-around py-2">
      <a href="/spv/dashboard" class="flex flex-col items-center text-blue-600">
        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20"><path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"></path></svg>
        <span class="text-xs">Dashboard</span>
      </a>
      <a href="/spv/report" class="flex flex-col items-center text-gray-500 hover:text-blue-600">
   
     <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-6a2 2 0 012-2h2a2 2 0 012 2v6m-6 0h6"></path></svg>
        <span class="text-xs">Reports</span>
      </a>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.14.0/Sortable.min.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      if (window.innerWidth >= 768) {
        var checklistTbody = document.getElementById('checklist-tbody');
        Sortable.create(checklistTbody, { 
          animation: 150, 
          ghostClass: 'dragging', 
          onEnd: function(evt) { 
            var order = Array.from(checklistTbody.querySelectorAll('tr')).map(row => row.getAttribute('data-id'));
            fetch('/spv/checklists/sort', { 
              method: 'POST', 
              headers: { 'Content-Type': 'application/json' }, 
              body: JSON.stringify({ order: order }) 
            }).catch(err => console.error('Checklist sort error:', err));
          } 
        });
        var assetTbody = document.getElementById('asset-tbody');
        Sortable.create(assetTbody, { 
          animation: 150, 
          ghostClass: 'dragging', 
          onEnd: function(evt) { 
            var order = Array.from(assetTbody.querySelectorAll('tr')).map(row => row.getAttribute('data-id'));
            fetch('/spv/assets/sort', { 
              method: 'POST', 
              headers: { 'Content-Type': 'application/json' }, 
              body: JSON.stringify({ order: order }) 
            }).catch(err => console.error('Asset sort error:', err));
          } 
        });
      }
    });
    
    const assetSearch = document.getElementById('asset-search');
    const assetFloorFilter = document.getElementById('asset-floor-filter');
    const assetCategoryFilter = document.getElementById('asset-category-filter');
    function filterAssets() {
      const searchTerm = assetSearch.value.toLowerCase();
      const selectedFloor = assetFloorFilter.value;
      const selectedCategory = assetCategoryFilter.value;
      const assetItems = document.querySelectorAll('.asset-item');
      
      assetItems.forEach(item => {
        const assetName = item.getAttribute('data-name');
        const assetFloor = item.getAttribute('data-floor');
        const assetCategory = item.getAttribute('data-category');
        
        const nameMatch = searchTerm === '' || assetName.includes(searchTerm);
        const floorMatch = selectedFloor === 'all' || assetFloor === selectedFloor;
        const categoryMatch = selectedCategory === 'all' || assetCategory === selectedCategory;

    
     item.style.display = (nameMatch && floorMatch && categoryMatch) ? '' : 'none';
      });
    }

    assetSearch.addEventListener('input', filterAssets);
    assetFloorFilter.addEventListener('change', filterAssets);
    assetCategoryFilter.addEventListener('change', filterAssets);
  </script>
</body>
</html>