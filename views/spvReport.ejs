<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SPV Maintenance Report</title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="bg-gray-100">
  <div class="max-w-6xl mx-auto p-4">
    <h1 class="text-3xl font-bold mb-6 text-center">SPV Maintenance Report</h1>
    <div class="overflow-x-auto">
      <table class="min-w-full bg-white shadow-md rounded border">
        <thead>
          <tr class="bg-gray-200">
            <th class="py-2 px-4 border">Asset Name</th>
            <th class="py-2 px-4 border">Checklist Title</th>
            <th class="py-2 px-4 border">Technician</th>
            <th class="py-2 px-4 border">Submitted Date</th>
            <th class="py-2 px-4 border">Verified By</th>
            <th class="py-2 px-4 border">Action</th>
          </tr>
        </thead>
        <tbody>
          <% assignments.forEach(function(assignment) { %>
            <tr class="border-b">
              <td class="py-2 px-4 border"><%= assignment.asset.name %></td>
              <td class="py-2 px-4 border"><%= assignment.checklist?.title || 'N/A' %></td>
              <td class="py-2 px-4 border"><%= assignment.submittedBy?.name || 'N/A' %></td>
              <td class="py-2 px-4 border">
                <%= new Date(assignment.completedAt).toLocaleDateString() %>
              </td>
              <td class="py-2 px-4 border">
                <% if (assignment.verifiedByManager) { %>
                  <span class="text-green-600 font-bold">Manager</span>
                <% } else if (assignment.verifiedBySpv) { %>
                  <span class="text-blue-600 font-bold">SPV</span>
                <% } else { %>
                  <span class="text-yellow-600 font-bold">Not Verified</span>
                <% } %>
              </td>
              <td class="py-2 px-4 border">
                <% if (!assignment.verifiedBySpv) { %>
                  <form method="POST" action="/spv/report/<%= assignment._id %>/verify" class="inline-block">
                    <button type="submit"
                      class="bg-blue-500 hover:bg-blue-600 text-white px-3 py-1 rounded text-sm">
                      Verify
                    </button>
                  </form>
                <% } else { %>
                  <span class="text-gray-500 italic text-sm">Verified</span>
                <% } %>
                <a href="/spv/report/<%= assignment._id %>/detail"
                   class="inline-block ml-2 bg-indigo-500 hover:bg-indigo-600 text-white px-3 py-1 rounded text-sm">
                  Checklist Detail
                </a>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Navigation -->
  <div class="max-w-6xl mx-auto mt-4 flex justify-end space-x-4">
    <a href="/spv/dashboard" class="text-blue-500 hover:text-blue-700">Dashboard</a>
    <a href="/logout" class="text-blue-500 hover:text-blue-700">Logout</a>
  </div>
</body>
</html>
