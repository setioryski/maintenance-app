<!DOCTYPE html>
<html>
<head>
    <title>Manage Divisions</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="bg-gray-100">
    <div class="container mx-auto p-6">
        <h1 class="text-3xl font-bold mb-6">Manage Divisions</h1>

        <% if (message && message.text) { %>
            <div class="p-4 mb-4 text-sm rounded-lg bg-green-100 text-green-700">
                <%= message.text %>
            </div>
        <% } %>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="bg-white p-6 rounded-lg shadow">
                <h2 class="text-xl font-semibold mb-4">Add New Division</h2>
                <form action="/admin/divisions" method="POST">
                    <div class="mb-4">
                        <label for="name" class="block text-gray-700">Division Name</label>
                        <input type="text" name="name" id="name" required class="mt-1 block w-full rounded-md border-gray-300 shadow-sm">
                    </div>
                    <button type="submit" class="w-full bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">
                        Create Division
                    </button>
                </form>
            </div>

            <div class="bg-white p-6 rounded-lg shadow">
                <h2 class="text-xl font-semibold mb-4">Existing Divisions</h2>
                <ul>
                    <% divisions.forEach(function(division) { %>
                        <li class="flex justify-between items-center border-b py-2">
                            <span><%= division.name %></span>
                            <form action="/admin/divisions/<%= division._id %>/delete" method="POST" onsubmit="return confirm('Are you sure? This cannot be undone.');">
                                <button type="submit" class="text-red-500 hover:text-red-700">Delete</button>
                            </form>
                        </li>
                    <% }); %>
                </ul>
            </div>
        </div>

        <div class="mt-8">
            <a href="/admin/manage-data" class="text-indigo-600 hover:text-indigo-900">&larr; Back to Manage Data</a>
        </div>
    </div>
</body>
</html>