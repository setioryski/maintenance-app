<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SPV Reports</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="bg-gray-100">

<header class="bg-white shadow-sm sticky top-0 z-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
            <h1 class="text-xl font-bold text-gray-800">SPV Maintenance Reports</h1>
            <div class="flex items-center space-x-4">
                
 
 <a href="/spv/dashboard" class="text-sm font-medium text-gray-600 hover:text-blue-600">Dashboard</a>
                <a href="/logout" class="text-sm font-medium text-gray-600 hover:text-blue-600">Logout</a>
            </div>
        </div>
    </div>
</header>

<div class="container mx-auto p-4 sm:p-6">
    <form method="GET" action="/spv/report" class="mb-6 p-4 bg-white rounded-lg shadow grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 items-end">
        <div>
            <label for="status_filter" class="block text-sm font-medium text-gray-700">Status</label>
    
  
       <select name="filter" id="status_filter" onchange="this.form.submit()" class="mt-1 block w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm rounded-md">
                <option value="all" <%= currentFilter === 'all' ? 'selected' : '' %>>All Reports</option>
                <option value="verified_spv" <%= currentFilter === 'verified_spv' ? 'selected' : '' %>>Verified by You</option>
                <option value="verified_manager" <%= currentFilter === 'verified_manager' ? 'selected' : '' %>>Approved by Manager</option>
                <option value="has_alert" <%= currentFilter === 'has_alert' ? 'selected' : '' %>>With Alerts</option>
                <option value="rejected" <%= currentFilter === 'rejected' ? 'selected' : '' %>>Rejected</option>
            </select>
        </div>
        <div>
            <label for="floor_filter" class="block text-sm font-medium text-gray-700">Floor</label>
            <select name="floor" id="floor_filter" class="mt-1 block w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm rounded-md">
                <option value="all" <%= currentFloor === 'all' ? 'selected' : '' %>>All Floors</option>
                <% floors.forEach(floor => { %>
                <option value="<%= floor._id %>" <%= currentFloor === floor._id.toString() ? 'selected' : '' %>><%= floor.name %></option>
                <% }) %>
            </select>
        </div>
        <div>
            <label for="zone_filter" class="block text-sm font-medium text-gray-700">Zone</label>
            <select name="zone" id="zone_filter" onchange="this.form.submit()" class="mt-1 block w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm rounded-md">
                <option value="all" <%= currentZone === 'all' ? 'selected' : '' %>>All Zones</option>
                <% zones.forEach(zone => { %>
                <option value="<%= zone._id %>" <%= currentZone === zone._id.toString() ? 'selected' : '' %> data-floor="<%= zone.floor %>"><%= zone.name %></option>
                <% }) %>
            </select>
        </div>
        
 
 <div>
            <label for="submitted_by_filter" class="block text-sm font-medium text-gray-700">Technician</label>
            <select name="submittedBy" id="submitted_by_filter" onchange="this.form.submit()" class="mt-1 block w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm rounded-md">
                <option value="all" <%= currentSubmittedBy === 'all' ? 'selected' : '' %>>All Technicians</option>
                <% technicians.forEach(tech => { %>
                <option value="<%= tech._id %>" <%= currentSubmittedBy === tech._id.toString() ? 'selected' : '' %>><%= tech.name %></option>
                <% }) %>
            </select>
        </div>
    </form>

    
 
 <div class="overflow-x-auto bg-white shadow-lg rounded-lg">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Asset & Checklist</th>
                    <th class="px-6 py-3 text-left text-xs 
 font-medium 
 text-gray-500 uppercase tracking-wider">Submission</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            
 <tbody class="bg-white 
 divide-y divide-gray-200">
            <% if (assignments.length > 0) { %>
                <% assignments.forEach(report => { %>
                <tr id="report-row-<%= report._id %>" data-id="<%= report._id %>" class="hover:bg-gray-50 <%= report.verifiedStatus === 'rejected' ? 'bg-red-50' : '' %>">
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm font-medium text-gray-900"><%= report.assetSnapshot?.name || 'N/A' %></div>
                        <div class="text-sm text-gray-500"><%= report.checklistTitle || 'N/A' %></div>
             
 
       </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm text-gray-900"><%= report.submittedByName || 'N/A' %></div>
                        <div class="text-sm text-gray-500"><%= new Date(report.completedAt).toLocaleString() %></div>
           
 
         </td>
                    <td class="px-6 py-4 whitespace-nowrap status-cell">
                        <% if (report.verifiedStatus === 'rejected') { %>
                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">Rejected 
 
 by <%= report.rejectedByName || 'N/A' %></span>
                        <% } else if (report.verifiedByManager) { %>
                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">Approved by Manager</span>
                        <% } 
 else 
 if (report.verifiedBySpv) { %>
                           <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-blue-100 text-blue-800">Verified by You</span>
                        <% } else { %>
                            <span class="px-2 
 inline-flex text-xs 
 leading-5 font-semibold rounded-full bg-yellow-100 text-yellow-800">Pending Your Verification</span>
                        <% } %>
                        <% if (report.hasAlert) { %>
                            <span class="px-2 ml-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-yellow-100 
 text-yellow-800">Alert</span>
   
                     <% } %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium action-cell">
                        <a href="/spv/report/<%= report._id %>/detail" 
 class="text-indigo-600 hover:text-indigo-900 mr-4">Detail</a>
 
                        <% if (report.verifiedStatus !== 'rejected' && !report.verifiedBySpv) { %>
                             <button type="button" class="text-green-600 hover:text-green-900 verify-btn" data-id="<%= report._id %>">Verify</button>
                        <% } %>
   
     
                 <% if (report.verifiedStatus !== 'rejected' && !report.verifiedByManager) { %>
                             <button type="button" class="text-red-600 hover:text-red-900 reject-btn ml-2" data-id="<%= report._id %>">Reject</button>
                        <% } %>
        
     
         </td>
                </tr>
                <% }); %>
            <% } else { %>
                <tr>
                    <td colspan="4" class="px-6 py-12 text-center text-sm text-gray-500">No reports found for the selected filter.</td>
                </tr>
            <% } %>
      
 
       </tbody>
        </table>

        <% if (assignments.length > 0 && totalPages > 1) { %>
            <div class="px-6 py-4 bg-white border-t flex flex-col xs:flex-row items-center xs:justify-between">
                <span class="text-xs xs:text-sm text-gray-700">
                    Showing <%= Math.min(((currentPage - 1) * limit) + 1, totalReports) %> to <%= Math.min(currentPage * limit, totalReports) %> of <%= totalReports %> Entries
                </span>
                <div class="inline-flex mt-2 xs:mt-0">
                    <%
                        const queryParams = new URLSearchParams({
  
                           filter: currentFilter,
                            floor: currentFloor,
                            zone: currentZone,
                            submittedBy: currentSubmittedBy
               
         });
 %>
                    <% if (currentPage > 1) { %>
                        <% queryParams.set('page', currentPage - 1);
 %>
                        <a href="/spv/report?<%= queryParams.toString() %>" class="text-sm bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-2 px-4 rounded-l">
                            Prev
                        </a>
             
        <% } %>
                    <% if (currentPage < totalPages) { %>
                        <% queryParams.set('page', currentPage + 1);
 %>
                        <a href="/spv/report?<%= queryParams.toString() %>" class="text-sm bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-2 px-4 rounded-r">
                            Next
                        </a>
             
        <% } %>
                </div>
            </div>
        <% } %>
    </div>
</div>

<div id="rejection-modal" class="fixed z-10 inset-0 overflow-y-auto hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
  <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
    <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" aria-hidden="true"></div>
    <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>
    <div class="inline-block align-bottom bg-white rounded-lg 
 text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full">
      <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
        <div class="sm:flex sm:items-start">
   
       <div class="mx-auto flex-shrink-0 flex items-center justify-center h-12 w-12 rounded-full bg-red-100 sm:mx-0 sm:h-10 sm:w-10">
            <svg class="h-6 w-6 text-red-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 
 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
    
       <div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left">
            <h3 class="text-lg leading-6 font-medium text-gray-900" id="modal-title">
              Confirm Rejection
            </h3>
           
 <div class="mt-2">
              <p class="text-sm text-gray-500">
                
 Are you sure you want to reject this maintenance report?
 This action cannot be undone.
 </p>
            </div>
          </div>
        </div>
      </div>
      <div class="bg-gray-50 px-4 py-3 sm:px-6 sm:flex sm:flex-row-reverse">
        <button id="confirm-reject-btn" type="button" class="w-full inline-flex justify-center rounded-md border border-transparent shadow-sm px-4 py-2 bg-red-600 text-base font-medium text-white hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 sm:ml-3 sm:w-auto sm:text-sm">
          Reject
      
   </button>
   
     <button id="cancel-reject-btn" type="button" class="mt-3 w-full inline-flex justify-center rounded-md border border-gray-300 shadow-sm px-4 py-2 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 sm:mt-0 sm:w-auto sm:text-sm">
          Cancel
        </button>
      </div>
    </div>
  </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const modal = document.getElementById('rejection-modal');
        const confirmBtn = document.getElementById('confirm-reject-btn');
        const cancelBtn = document.getElementById('cancel-reject-btn');
        let actionUrl = '';
        let rowToUpdate = null;
        const handleAction = async (url, row, action) => {
            try {
                const response = await fetch(url, { 
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }
          
       });

                if (!response.ok) {
                    throw new Error(`Server responded with status: ${response.status}`);
 }
                
                const result = await response.json();
 if (result.success) {
                    const statusCell = row.querySelector('.status-cell');
 const actionCell = row.querySelector('.action-cell');
                    const reportId = row.dataset.id;
                    
                    if (action === 'verify') {
                        statusCell.innerHTML = `<span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-blue-100 text-blue-800">Verified by You</span>`;
 // Remove verify button, keep reject button if applicable
                        actionCell.innerHTML = `
                            <a href="/spv/report/${reportId}/detail" class="text-indigo-600 hover:text-indigo-900 mr-4">Detail</a>
                            <button type="button" class="text-red-600 hover:text-red-900 reject-btn ml-2" 
 
 data-id="${reportId}">Reject</button>
                        `;
 } else if (action === 'reject') {
                        statusCell.innerHTML = `<span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">Rejected by You</span>`;
 // Remove all action buttons
                        actionCell.innerHTML = `<a href="/spv/report/${reportId}/detail" class="text-indigo-600 hover:text-indigo-900 mr-4">Detail</a>`;
 row.classList.add('bg-red-50');
                    }
                } else {
                    alert('Action failed: ' + (result.message || 'Unknown error'));
 }
            } catch (error) {
                console.error('An error occurred:', error);
 alert('An error occurred. Please check the console and try again.');
 } finally {
                if (modal) modal.classList.add('hidden');
 }
        };

        // Use event delegation for dynamically added buttons
        document.body.addEventListener('click', (e) => {
            const target = e.target;
            const reportId = target.dataset.id;
            if (!reportId) return;

            const row = document.getElementById(`report-row-${reportId}`);
            if (!row) 
 
 return;

            if (target.classList.contains('verify-btn')) {
                handleAction(`/spv/report/${reportId}/verify`, row, 'verify');
            }
 
            if (target.classList.contains('reject-btn')) {
                rowToUpdate = row;
                actionUrl = `/spv/report/${reportId}/reject`;
    
  
           modal.classList.remove('hidden');
            }
        });
 confirmBtn.addEventListener('click', () => {
            if (actionUrl && rowToUpdate) {
                handleAction(actionUrl, rowToUpdate, 'reject');
            }
        });
 cancelBtn.addEventListener('click', () => {
            modal.classList.add('hidden');
            actionUrl = '';
            rowToUpdate = null;
        });

      const floorFilter = document.getElementById('floor_filter');
      const zoneFilter = document.getElementById('zone_filter');
      const allZones = Array.from(zoneFilter.options);

      function updateZoneFilter() {
        const selectedFloorId = floorFilter.value;
        const selectedZoneId = zoneFilter.value;

        zoneFilter.innerHTML = '';
        allZones.forEach(option => {
            if (option.value === 'all' || option.dataset.floor === selectedFloorId) {
                zoneFilter.add(option.cloneNode(true));
            }
        });

        if (selectedFloorId === 'all') {
            zoneFilter.disabled = true;
            zoneFilter.value = 'all';
        } else {
            zoneFilter.disabled = false;
            zoneFilter.value = selectedZoneId;
        }
      }

      floorFilter.addEventListener('change', () => {
        zoneFilter.value = 'all'; // Reset zone filter when floor changes
        updateZoneFilter();
        floorFilter.form.submit();
      });

      // Initial filter state
      updateZoneFilter();
 });
</script>
</body>
</html>