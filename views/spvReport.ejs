<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SPV Maintenance Report</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="bg-gray-100">
<div class="container mx-auto p-4">
    <h1 class="text-3xl font-bold mb-6 text-center">SPV Maintenance Report</h1>
    
    <div class="mb-4 flex justify-center gap-2">
        <a href="/spv/report?filter=all" class="px-4 py-2 rounded-md text-sm font-medium <%= currentFilter === 'all' ? 'bg-blue-600 text-white' : 'bg-white text-gray-700' %>">All Reports</a>
        <a href="/spv/report?filter=has_alert" class="px-4 py-2 rounded-md text-sm font-medium <%= currentFilter === 'has_alert' ? 'bg-yellow-500 text-white' : 'bg-white text-gray-700' %>">With Alerts</a>
        <a href="/spv/report?filter=rejected" class="px-4 py-2 rounded-md text-sm font-medium <%= currentFilter === 'rejected' ? 'bg-red-600 text-white' : 'bg-white text-gray-700' %>">Rejected</a>
    </div>

    <div class="overflow-x-auto bg-white shadow rounded-lg">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Asset / Checklist</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Technician / Date</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Verification Status</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
            <% if (assignments.length > 0) { %>
                <% assignments.forEach(assignment => { %>
                <tr class="<%= assignment.hasAlert && assignment.verifiedStatus !== 'rejected' ? 'bg-yellow-50' : '' %> <%= assignment.verifiedStatus === 'rejected' ? 'bg-red-50' : '' %>">
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm font-medium text-gray-900"><%= assignment.asset?.name || 'N/A' %></div>
                        <div class="text-sm text-gray-500"><%= assignment.checklist?.title || 'N/A' %></div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm text-gray-900"><%= assignment.submittedBy?.name || 'N/A' %></div>
                        <div class="text-sm text-gray-500"><%= new Date(assignment.completedAt).toLocaleString() %></div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <% if (assignment.verifiedStatus === 'rejected') { %>
                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">Rejected</span>
                        <% } else if (assignment.verifiedByManager) { %>
                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">Verified by Manager</span>
                        <% } else if (assignment.verifiedBySpv) { %>
                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-blue-100 text-blue-800">Verified by SPV</span>
                        <% } else { %>
                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-gray-100 text-gray-800">Pending SPV</span>
                        <% } %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                        <a href="/spv/report/<%= assignment._id %>/detail" class="text-indigo-600 hover:text-indigo-900 mr-4">Detail</a>
                        <% if (assignment.verifiedStatus !== 'rejected' && !assignment.verifiedBySpv) { %>
                            <form method="POST" action="/spv/report/<%= assignment._id %>/verify" class="inline">
                                <button type="submit" class="text-green-600 hover:text-green-900">Verify</button>
                            </form>
                            <form method="POST" action="/spv/report/<%= assignment._id %>/reject" class="inline ml-4">
                                <button type="submit" class="text-red-600 hover:text-red-900">Reject</button>
                            </form>
                        <% } %>
                    </td>
                </tr>
                <% }); %>
            <% } else { %>
                <tr>
                    <td colspan="4" class="px-6 py-4 text-center text-sm text-gray-500">No reports found.</td>
                </tr>
            <% } %>
            </tbody>
        </table>
    </div>
     <div class="mt-6 text-center">
        <a href="/spv/dashboard" class="text-indigo-600 hover:text-indigo-900 mr-4">Dashboard</a>
        <a href="/logout" class="text-indigo-600 hover:text-indigo-900">Logout</a>
    </div>
</div>
</body>
</html>
