<!DOCTYPE html>
<html>
<head>
    <title>Edit User</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <script>
        function toggleDivision() {
            const roleSelect = document.getElementById('roleSelect');
            const divisionField = document.getElementById('divisionField');
            if (roleSelect.value === 'spv' || roleSelect.value === 'technician') {
                divisionField.style.display = 'block';
            } else {
                divisionField.style.display = 'none';
            }
        }
        window.onload = toggleDivision;
    </script>
</head>
<body class="bg-gray-100">
    <div class="container mx-auto p-6">
        <h1 class="text-3xl font-bold mb-6">Edit User: <%= userToEdit.name %></h1>

        <div class="bg-white shadow-md rounded px-8 pt-6 pb-8 mb-4">
            <% /* --- CORRECTED FORM ACTION --- */ %>
            <form action="/admin/users/<%= userToEdit._id %>/edit" method="POST">
                <div class="mb-4">
                    <label class="block text-gray-700 text-sm font-bold mb-2">Name:</label>
                    <input type="text" name="name" value="<%= userToEdit.name %>" required class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline">
                </div>
                <div class="mb-4">
                    <label class="block text-gray-700 text-sm font-bold mb-2">Email:</label>
                    <input type="email" name="email" value="<%= userToEdit.email %>" required class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline">
                </div>
                <div class="mb-4">
                    <label class="block text-gray-700 text-sm font-bold mb-2">Password (leave blank to keep current password):</label>
                    <input type="password" name="password" class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline">
                </div>
                <div class="mb-4">
                    <label class="block text-gray-700 text-sm font-bold mb-2">Role:</label>
                    <select id="roleSelect" name="role" required onchange="toggleDivision()" class="shadow border rounded w-full py-2 px-3 text-gray-700">
                        <option value="manager" <%= userToEdit.role === 'manager' ? 'selected' : '' %>>Manager</option>
                        <option value="superuser" <%= userToEdit.role === 'superuser' ? 'selected' : '' %>>Superuser</option>
                        <option value="spv" <%= userToEdit.role === 'spv' ? 'selected' : '' %>>Supervisor (SPV)</option>
                        <option value="technician" <%= userToEdit.role === 'technician' ? 'selected' : '' %>>Technician</option>
                    </select>
                </div>
                <div id="divisionField" style="display:none;" class="mb-4">
                    <label class="block text-gray-700 text-sm font-bold mb-2">Division:</label>
                    <select name="division" class="shadow border rounded w-full py-2 px-3 text-gray-700">
                        <option value="">Select Division</option>
                        <% divisions.forEach(function(division) { %>
                        <option value="<%= division._id %>" <%= userToEdit.division && userToEdit.division.toString() === division._id.toString() ? 'selected' : '' %>><%= division.name %></option>
                        <% }); %>
                    </select>
                </div>
                <div class="flex items-center justify-between">
                    <button type="submit" class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline">
                        Update User
                    </button>
                    <% /* --- CORRECTED LINK --- */ %>
                    <a href="/admin/users" class="inline-block align-baseline font-bold text-sm text-blue-500 hover:text-blue-800">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</body>
</html>