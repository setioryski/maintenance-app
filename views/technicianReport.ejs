<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Submitted Reports</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="bg-gray-100">
<div class="container mx-auto p-4">
    <h1 class="text-3xl font-bold mb-6 text-center">My Submitted Reports</h1>

    <div class="overflow-x-auto bg-white shadow rounded-lg">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Asset / Checklist</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Submission Date</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
            <% if (assignments.length > 0) { %>
                <% assignments.forEach(assignment => { %>
                <tr class="<%= assignment.verifiedStatus === 'rejected' ? 'bg-red-50' : '' %>">
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm font-medium text-gray-900">
                            <%# This is the corrected block %>
                            <% if (assignment.asset) { %>
                                <%= assignment.asset.name %>
                            <% } else if (assignment.assetSnapshot) { %>
                                <%= assignment.assetSnapshot.name %> (Deleted)
                            <% } else { %>
                                N/A
                            <% } %>
                        </div>
                        <div class="text-sm text-gray-500"><%= assignment.checklistTitle || 'N/A' %></div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                        <%= new Date(assignment.completedAt).toLocaleString() %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <% if (assignment.verifiedStatus === 'rejected') { %>
                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">Rejected</span>
                        <% } else if (assignment.verifiedByManager) { %>
                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">Approved</span>
                        <% } else if (assignment.verifiedBySpv) { %>
                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-blue-100 text-blue-800">Pending Manager</span>
                        <% } else { %>
                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-gray-100 text-gray-800">Pending SPV</span>
                        <% } %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                        <a href="/technician/report/<%= assignment._id %>" class="text-indigo-600 hover:text-indigo-900">View Detail</a>
                    </td>
                </tr>
                <% }); %>
            <% } else { %>
                <tr>
                    <td colspan="4" class="px-6 py-4 text-center text-sm text-gray-500">You have not submitted any reports yet.</td>
                </tr>
            <% } %>
            </tbody>
        </table>
    </div>
    <div class="mt-6 text-center">
        <a href="/technician/dashboard" class="text-indigo-600 hover:text-indigo-900">Back to Dashboard</a>
    </div>
</div>
</body>
</html>