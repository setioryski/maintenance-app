<!DOCTYPE html>
<html lang="en">
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta charset="UTF-8">
  <title>SPV Maintenance Report</title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="bg-gray-100">
  <div class="max-w-6xl mx-auto p-4">
    <h1 class="text-3xl font-bold mb-6 text-center">SPV Maintenance Report</h1>

    <div class="overflow-x-auto">
      <table class="min-w-full bg-white shadow-md rounded overflow-hidden">
        <thead>
          <tr class="bg-gray-200">
            <th class="py-2 px-4">Asset Name</th>
            <th class="py-2 px-4">Checklist Title</th>
            <th class="py-2 px-4">Technician</th>
            <th class="py-2 px-4">Submitted Date</th>
            <th class="py-2 px-4">Verification Status</th>
            <th class="py-2 px-4">Action</th>
          </tr>
        </thead>
        <tbody>
          <% assignments.forEach(function(assignment) { %>
          <tr class="border-b">
            <td class="py-2 px-4"><%= assignment.asset.name %></td>
            <td class="py-2 px-4"><%= assignment.checklist ? assignment.checklist.title : 'N/A' %></td>
            <td class="py-2 px-4"><%= assignment.submittedBy ? assignment.submittedBy.name : 'N/A' %></td>
            <td class="py-2 px-4"><%= new Date(assignment.completedAt).toLocaleDateString() %></td>
            <td class="py-2 px-4">
              <% if (assignment.verifiedStatus === 'verified') { %>
                <span class="text-green-600 font-bold">Verified</span>
              <% } else if (assignment.verifiedStatus === 'rejected') { %>
                <span class="text-red-600 font-bold">Rejected</span>
              <% } else { %>
                <span class="text-yellow-600 font-bold">Pending</span>
              <% } %>
            </td>
            <td class="py-2 px-4 space-y-2">
              <% if (assignment.verifiedStatus === 'pending') { %>
                <form action="/spv/report/<%= assignment._id %>/verify" method="POST" class="inline-block">
                  <button type="submit" class="bg-green-500 hover:bg-green-600 text-white px-3 py-1 rounded text-sm">
                    Verify
                  </button>
                </form>
                <form action="/spv/report/<%= assignment._id %>/reject" method="POST" class="inline-block ml-2">
                  <button type="submit" class="bg-red-500 hover:bg-red-600 text-white px-3 py-1 rounded text-sm">
                    Reject
                  </button>
                </form>
              <% } else { %>
                <span class="text-gray-400 text-sm italic block">Action Taken</span>
              <% } %>
              <div class="mt-2">
                <a href="/spv/report/<%= assignment._id %>/detail" 
                   class="bg-blue-500 hover:bg-blue-600 text-white px-3 py-1 rounded text-sm inline-block">
                  Checklist Detail
                </a>
              </div>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <div class="mt-6 flex justify-between">
      <a href="/spv/dashboard" class="bg-gray-500 hover:bg-gray-600 text-white px-4 py-2 rounded">
        Back to Dashboard
      </a>
      <a href="/logout" class="bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded">
        Logout
      </a>
    </div>
  </div>
</body>
</html>
