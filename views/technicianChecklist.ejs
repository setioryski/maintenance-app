<!DOCTYPE html>
<html lang="en">
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta charset="UTF-8">
  <title>Maintenance Checklist</title>
  <!-- Tailwind CSS -->
  <link
    href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css"
    rel="stylesheet"
  />
</head>
<body class="bg-gray-100">
  <div class="max-w-3xl mx-auto p-6 bg-white shadow-md rounded">
    <h1 class="text-2xl font-bold text-center mb-4">Maintenance Checklist</h1>

    <!-- Show Asset and Checklist info -->
    <p class="mb-2">
      Asset: <strong><%= assignment.asset.name %></strong>
    </p>
    <p class="mb-4">
      Checklist: <strong><%= assignment.checklist ? assignment.checklist.title : 'N/A' %></strong>
    </p>

    <!-- Form start -->
    <form
      action="/technician/checklist/<%= assignment._id %>/submit"
      method="POST"
      enctype="multipart/form-data"
    >
      <% 
        // Safely get tasks; default to an empty array if not defined.
        const tasks = (assignment.checklist && assignment.checklist.tasks) ? assignment.checklist.tasks : [];
      %>

      <% if (tasks.length > 0) { %>
        <% tasks.forEach(function(task) { %>
          <div class="mb-6 border p-4 rounded">
            <!-- Hidden field for task ID (if needed) -->
            <input type="hidden" name="taskIds[]" value="<%= task._id %>">

            <!-- Task description -->
            <label class="block text-gray-700 font-bold mb-2">
              <%= task.description %>
            </label>

            <!-- FUNCTIONAL task: pass/fail radio -->
            <% if (task.inputType === 'functional') { %>
              <div class="flex flex-col sm:flex-row sm:space-x-6">
                <label class="inline-flex items-center">
                  <input
                    type="radio"
                    name="results[<%= task._id %>]"
                    value="pass"
                    required
                  />
                  <span class="ml-2">Pass</span>
                </label>
                <label class="inline-flex items-center mt-2 sm:mt-0">
                  <input
                    type="radio"
                    name="results[<%= task._id %>]"
                    value="fail"
                    required
                  />
                  <span class="ml-2">Fail</span>
                </label>
              </div>

            <!-- MEASUREMENT task: numeric input -->
            <% } else if (task.inputType === 'measurement') { %>
              <div class="flex flex-col sm:flex-row items-start sm:items-center">
                <input
                  type="number"
                  name="results[<%= task._id %>]"
                  placeholder="Enter value"
                  class="shadow border rounded w-full py-2 px-3"
                  required
                />
                <% if (task.expectedUnit) { %>
                  <span class="sm:ml-2 mt-1 sm:mt-0 text-gray-600">
                    <%= task.expectedUnit %>
                  </span>
                <% } %>
              </div>

            <!-- VISUAL task: camera-only button + previews -->
            <% } else if (task.inputType === 'visual') { %>
              <!-- "Take Photo" button -->
              <button
                type="button"
                id="addImagesBtn-<%= task._id %>"
                class="w-full sm:w-auto bg-green-500 hover:bg-green-600 text-white py-2 px-4 rounded"
              >
                Take Photo
              </button>

              <!-- Hidden file input (camera only; single file per capture) -->
              <input
                type="file"
                id="imageInput-<%= task._id %>"
                name="results[<%= task._id %>]"
                accept="image/*"
                capture="environment"
                class="hidden"
              />

              <!-- Preview container for thumbnails -->
              <div
                id="previewContainer-<%= task._id %>"
                class="mt-4 flex flex-wrap gap-2"
              ></div>
            <% } %>
          </div>
        <% }); %>
      <% } else { %>
        <p class="text-gray-600">No tasks available for this checklist.</p>
      <% } %>

      <div class="mb-6">
        <label class="block text-gray-700 font-bold mb-2" for="note">Maintenance Note</label>
        <textarea
          id="note"
          name="note"
          rows="3"
          class="w-full border border-gray-300 rounded p-2"
          placeholder="Enter any maintenance note here..."
        ></textarea>
      </div>
      
      <!-- Submit button -->
      <div class="flex justify-end">
        <button
          type="submit"
          class="bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded"
        >
          Submit Checklist
        </button>
      </div>

    </form>
    <!-- Form end -->
  </div>

  <!-- Navigation links -->
  <div class="max-w-3xl mx-auto mt-4 flex flex-col sm:flex-row justify-end space-y-2 sm:space-y-0 sm:space-x-4">
    <a href="/technician/dashboard" class="text-blue-500 hover:text-blue-700">Dashboard</a>
    <a href="/logout" class="text-blue-500 hover:text-blue-700">Logout</a>
  </div>

  <!-- Inline scripts for each visual task -->
  <% tasks.forEach(function(task) { 
    if (task.inputType === 'visual') {
  %>
  <script>
    // Helper function to compress an image using the Canvas API
    function resizeImageWithCanvas(file, maxWidth) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = function(e) {
          const img = new Image();
          img.onload = function() {
            let width = img.width;
            let height = img.height;
            // Resize if image is wider than maxWidth
            if (width > maxWidth) {
              height = height * (maxWidth / width);
              width = maxWidth;
            }
            const canvas = document.createElement('canvas');
            canvas.width = width;
            canvas.height = height;
            const ctx = canvas.getContext('2d');
            ctx.drawImage(img, 0, 0, width, height);
            // Convert canvas to a JPEG blob at 70% quality
            canvas.toBlob(blob => {
              if (blob) {
                resolve(blob);
              } else {
                reject(new Error('Canvas is empty'));
              }
            }, 'image/jpeg', 0.7);
          };
          img.onerror = err => reject(err);
          img.src = e.target.result;
        };
        reader.onerror = err => reject(err);
        reader.readAsDataURL(file);
      });
    }
  
    // Inline script for visual tasks in technicianChecklist.ejs
    (function() {
      // 'task' variable is provided by the EJS loop for each visual task
      const taskId = "<%= task._id %>";
      const addImagesBtn = document.getElementById('addImagesBtn-' + taskId);
      const imageInput = document.getElementById('imageInput-' + taskId);
      const previewContainer = document.getElementById('previewContainer-' + taskId);
      // DataTransfer to hold the compressed files for this task
      const dt = new DataTransfer();
  
      // Trigger file input when "Take Photo" button is clicked
      addImagesBtn.addEventListener('click', () => {
        imageInput.click();
      });
  
      imageInput.addEventListener('change', async () => {
        if (imageInput.files.length > 0) {
          try {
            const originalFile = imageInput.files[0];
            // Compress the image to a maximum width of 800px
            const compressedBlob = await resizeImageWithCanvas(originalFile, 800);
            // Create a new File object from the compressed blob
            const compressedFile = new File([compressedBlob], originalFile.name, { type: 'image/jpeg' });
            // Add the compressed file to our DataTransfer object
            dt.items.add(compressedFile);
            // Update the file input's FileList
            imageInput.files = dt.files;
            renderPreview();
          } catch (error) {
            console.error("Error compressing image:", error);
          }
        }
      });
  
      function renderPreview() {
        // Clear existing previews
        previewContainer.innerHTML = '';
        // Loop through the DataTransfer items and render thumbnails
        for (let i = 0; i < dt.items.length; i++) {
          const file = dt.items[i].getAsFile();
          const fileReader = new FileReader();
          fileReader.onload = (e) => {
            const wrapper = document.createElement('div');
            wrapper.classList.add('relative', 'w-20', 'h-20', 'border', 'rounded', 'overflow-hidden');
            const img = document.createElement('img');
            img.src = e.target.result;
            img.classList.add('w-full', 'h-full', 'object-cover');
            // Create a remove button for the thumbnail
            const removeBtn = document.createElement('button');
            removeBtn.type = 'button';
            removeBtn.classList.add('absolute', 'top-0', 'right-0', 'bg-red-500', 'text-white', 'rounded-full', 'w-5', 'h-5', 'text-xs', 'flex', 'items-center', 'justify-center');
            removeBtn.innerHTML = '&times;';
            removeBtn.addEventListener('click', () => {
              dt.items.remove(i);
              imageInput.files = dt.files;
              renderPreview();
            });
            wrapper.appendChild(img);
            wrapper.appendChild(removeBtn);
            previewContainer.appendChild(wrapper);
          };
          fileReader.readAsDataURL(file);
        }
      }
    })();
  </script>
  
  <% } }); %>
</body>
</html>
