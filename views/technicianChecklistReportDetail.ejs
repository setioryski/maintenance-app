<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Checklist Report Detail</title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="bg-gray-100">
  <div class="max-w-4xl mx-auto p-6 bg-white shadow-md rounded">
    <h1 class="text-2xl font-bold mb-4">Checklist Report Detail</h1>

    <!-- Report Header -->
    <div class="mb-6 space-y-1">
      <p><strong>Asset:</strong> <%= assignment.asset.name %></p>
      <p><strong>Checklist:</strong> <%= assignment.checklist ? assignment.checklist.title : 'N/A' %></p>
      <p>
        <strong>Submitted On:</strong>
        <%= assignment.completedAt.toLocaleDateString('id-ID', { timeZone: 'Asia/Jakarta' }) %> at 
        <%= assignment.completedAt.toLocaleTimeString('id-ID', { timeZone: 'Asia/Jakarta' }) %>
      </p>
      <p><strong>Technician:</strong> <%= assignment.submittedBy ? assignment.submittedBy.name : 'N/A' %></p>
      <p><strong>Verified by SPV:</strong> 
        <% if (assignment.verifiedBySpv) { %><span class="text-blue-600 font-semibold">Yes</span><% } else { %><span class="text-yellow-600 font-semibold">No</span><% } %>
      </p>
      <p><strong>Verified by Manager:</strong> 
        <% if (assignment.verifiedByManager) { %><span class="text-green-600 font-semibold">Yes</span><% } else { %><span class="text-yellow-600 font-semibold">No</span><% } %>
      </p>
    </div>

    <!-- Task Responses -->
    <h2 class="text-xl font-semibold mb-4">Task Responses</h2>
    <div class="space-y-6">
      <% 
        // Determine tasks list (snapshot or fallback)
        const tasksList = (assignment.tasksSnapshot && assignment.tasksSnapshot.length)
          ? assignment.tasksSnapshot.map(t => ({ desc: t.description, type: t.inputType, unit: t.expectedUnit, id: t.originalTaskId }))
          : (assignment.checklist && assignment.checklist.tasks)
            ? assignment.checklist.tasks.map(t => ({ desc: t.description, type: t.inputType, unit: t.expectedUnit, id: t._id }))
            : [];
      %>

      <% if (!tasksList.length) { %>
        <p class="text-gray-600">No tasks available for this report.</p>
      <% } else { %>
        <% tasksList.forEach(task => {
             const resp = assignment.responses[task.id] || assignment.responses[task.id.toString()] || '';
        %>
          <div class="border-b pb-4">
            <p class="font-medium"><%= task.desc %></p>
            <p class="text-sm text-gray-600">
              Jenis: <%= task.type.charAt(0).toUpperCase() + task.type.slice(1) %>
              <% if (task.type === 'measurement') { %>&nbsp;(<%= task.unit %>)<% } %>
            </p>
            <div class="mt-2">
              <strong>Response:</strong>
              <% if (Array.isArray(resp) && resp.length) { %>
                <!-- gallery container -->
                <div 
                  class="flex flex-wrap gap-2 mt-2 cursor-pointer" 
                  data-images="<%= encodeURIComponent(JSON.stringify(resp)) %>"
                  onclick="openGalleryFromDiv(this)">
                  <% resp.forEach(src => { %>
                    <img src="<%= src %>" alt="Task Image" class="w-24 h-24 object-cover rounded shadow" />
                  <% }); %>
                </div>
              <% } else { %>
                <span><%= resp || 'No response provided' %></span>
              <% } %>
            </div>
          </div>
        <% }); %>
      <% } %>
    </div>

    <!-- Maintenance Note -->
    <div class="mt-6">
      <h2 class="text-xl font-semibold mb-2">Maintenance Note</h2>
      <p class="text-gray-700"><%= assignment.note || 'No note provided' %></p>
    </div>

    <!-- Navigation Links -->
    <div class="mt-6 flex justify-between">
      <a href="/technician/report" class="bg-gray-500 hover:bg-gray-600 text-white px-4 py-2 rounded">Back to Reports</a>
      <a href="/technician/dashboard" class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded">Dashboard</a>
    </div>
  </div>

  <!-- GALLERY MODAL -->
  <div id="galleryModal" class="fixed inset-0 z-50 hidden items-center justify-center">
    <div class="absolute inset-0 bg-black bg-opacity-70" onclick="closeGallery()"></div>
    <div class="relative bg-white p-4 rounded max-w-4xl w-full mx-auto mt-10">
      <h2 class="text-xl font-bold mb-2">Images</h2>
      <div id="galleryGrid" class="grid grid-cols-2 md:grid-cols-4 gap-2"></div>
      <button class="mt-4 px-4 py-2 bg-gray-200 hover:bg-gray-300 rounded" onclick="closeGallery()">Close</button>
    </div>
  </div>

  <!-- ENLARGED MODAL -->
  <div id="enlargedModal" class="fixed inset-0 z-50 hidden items-center justify-center">
    <div class="absolute inset-0 bg-black bg-opacity-80" onclick="closeEnlarged()"></div>
    <img id="enlargedImg" class="relative max-h-[80vh] mx-auto mt-10 rounded shadow-lg" src="" alt="Enlarged">
  </div>

  <!-- Gallery Script -->
  <script>
    function parseImagesAttr(el) {
      try {
        return JSON.parse(decodeURIComponent(el.getAttribute('data-images')));
      } catch {
        return [];
      }
    }
    function openGalleryFromDiv(div) {
      const imgs = parseImagesAttr(div);
      openGallery(imgs);
    }
    function openGallery(images) {
      const modal = document.getElementById('galleryModal');
      const grid = document.getElementById('galleryGrid');
      grid.innerHTML = '';
      images.forEach(path => {
        const img = document.createElement('img');
        img.src = path;
        img.className = 'w-full h-32 object-cover cursor-pointer border rounded';
        img.onclick = () => enlargeImage(path);
        grid.appendChild(img);
      });
      modal.classList.remove('hidden'); modal.classList.add('flex');
    }
    function closeGallery() {
      const m = document.getElementById('galleryModal');
      m.classList.add('hidden'); m.classList.remove('flex');
    }
    function enlargeImage(src) {
      const m = document.getElementById('enlargedModal');
      const img = document.getElementById('enlargedImg');
      img.src = src;
      m.classList.remove('hidden'); m.classList.add('flex');
    }
    function closeEnlarged() {
      const m = document.getElementById('enlargedModal');
      m.classList.add('hidden'); m.classList.remove('flex');
    }
  </script>
</body>
</html>
