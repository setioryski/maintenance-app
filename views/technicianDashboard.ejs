<!DOCTYPE html>
<html lang="en">
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta charset="UTF-8">
  <title>Technician Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
  
  <link rel="manifest" href="/manifest.json">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="MaintApp">
  <meta name="theme-color" content="#4a90e2"/>
  <link rel="apple-touch-icon" href="/image/logo.png">

</head>
<body class="bg-gray-50">

  <script>
    // Redirect non-technician users to their correct dashboard when online
    const userRole = "<%= locals.user ? user.userRole : '' %>";
    if (navigator.onLine && userRole && userRole !== 'technician') {
        const dashboardUrls = {
            'superuser': '/admin/dashboard',
            'manager': '/manager/dashboard',
            'spv': '/spv/dashboard'
        };
        if (dashboardUrls[userRole]) {
            window.location.href = dashboardUrls[userRole];
        }
    }
  </script>
  
  <header class="bg-white shadow-sm sticky top-0 z-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center h-16">
        <div class="flex items-center">
            <div class="flex-shrink-0">
             <img src="/image/logo.png" alt="Company Logo" class="h-8">
            </div>
         
            <div id="status-indicator-mobile" class="md:hidden flex items-center space-x-2 ml-4 px-2 py-1 rounded-full text-xs">
                <span id="status-dot-mobile" class="w-2 h-2 rounded-full"></span>
                <span id="status-text-mobile" class="font-semibold"></span>
          </div>
        </div>

        <div class="hidden md:flex items-center space-x-4">

           <div id="status-indicator-desktop" class="flex items-center space-x-2 px-3 py-1 rounded-full">
             <span id="status-dot-desktop" class="w-3 h-3 rounded-full"></span>
             <span id="status-text-desktop" class="text-sm font-semibold"></span>
           </div>
        
   <a href="/technician/dashboard" class="bg-blue-600 text-white px-3 py-2 rounded-md text-sm font-medium">Dashboard</a>
           <a id="my-reports-link-desktop" href="/technician/report" class="text-gray-500 hover:bg-gray-200 hover:text-gray-900 px-3 py-2 rounded-md text-sm font-medium">My Reports</a>
           <a href="/logout" class="text-gray-500 hover:bg-gray-200 hover:text-gray-900 px-3 py-2 rounded-md text-sm font-medium">Logout</a>
        </div>
        <div class="md:hidden">
          <a href="/logout" class="text-gray-500 text-sm">Logout</a>
        </div>
      </div>
 </div>
  </header>

  <main class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
    <div class="px-4 py-6 sm:px-0">
        <div id="pending-sync-alert" class="hidden mb-6 p-4 bg-yellow-100 border-l-4 border-yellow-500 text-yellow-700 rounded-lg flex items-center justify-between">
            <div>
                <p class="font-bold">Work Saved Offline</p>
                <p>You have <strong id="pending-sync-count">0</strong> submission(s) waiting to be synced.</p>
    </div>
            <button id="sync-now-btn" class="bg-yellow-500 hover:bg-yellow-600 text-white font-bold py-2 px-4 rounded">
                Sync Now
            </button>
        </div>

        <div class="flex flex-col md:flex-row items-start justify-between mb-6">
            <div>
   <h1 class="text-3xl font-bold text-gray-900">Technician Dashboard</h1>
                <p class="text-sm text-gray-500">Here are your assigned maintenance tasks and recent activities.</p>
            </div>
            <div class="flex space-x-2 mt-4 md:mt-0">
                <button id="scan-qr-btn" class="bg-purple-600 hover:bg-purple-700 text-white font-semibold py-2 px-4 rounded-lg shadow-sm transition duration-300 flex items-center">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                    Scan QR Code
                </button>
            </div>
        </div>

        <div id="qr-reader" class="hidden mx-auto md:w-96 mb-6"></div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <div class="lg:col-span-2">
                <div class="bg-white p-6 rounded-lg shadow-lg">
                    <h2 class="text-xl font-bold mb-4">My Maintenance Tasks</h2>

                    <div class="mb-6 p-4 bg-gray-50 rounded-lg border">
                        <form id="filter-form" method="GET" action="/technician/dashboard" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
                            <input
                                type="text"
                                name="search"
                                id="searchInput"
                                placeholder="Search by asset name..."
                                class="col-span-1 sm:col-span-2 md:col-span-4 border border-gray-300 rounded-md px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
                                value="<%= currentSearch %>"
                            >
                            <select name="floor" id="floorFilter" class="w-full border border-gray-300 rounded-md px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                                <option value="all">All Floors</option>
                                <% floors.forEach(function(floor) { %>
                                <option value="<%= floor.name.toLowerCase() %>" <%= currentFloor === floor.name.toLowerCase() ? 'selected' : '' %> data-floor-id="<%= floor._id %>"><%= floor.name %></option>
                                <% }); %>
                            </select>
                            <select name="category" id="categoryFilter" class="w-full border border-gray-300 rounded-md px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                                <option value="all">All Categories</option>
                                <% assetCategories.forEach(function(cat) { %>
                                <option value="<%= cat.name.toLowerCase() %>" <%= currentCategory === cat.name.toLowerCase() ? 'selected' : '' %>><%= cat.name %></option>
                                <% }); %>
                            </select>
                            <select name="zone" id="zoneFilter" class="w-full border border-gray-300 rounded-md px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                                <option value="all">All Zones</option>
                                <% allZones.forEach(function(zone) { %>
                                <option value="<%= zone._id %>" class="zone-option hidden" data-floor-of-zone="<%= zone.floor %>" <%= currentZone === zone._id.toString() ? 'selected' : '' %>><%= zone.name %></option>
                                <% }); %>
                            </select>
                        </form>
                    </div>

                    <%
            const getAssetIcon = (name) => {
                        name = (name || '').toLowerCase();
 if (name.includes('cctv')) return '📷';
                        if (name.includes('panoramic')) return '🌅';
                        if (name.includes('smoke') || name.includes('fire')) return '🔥';
                        if (name.includes('ahu')) return '💨';
 if (name.includes('elevator')) return '↕️';
                        if (name.includes('generator')) return '⚡️';
                        return '📦';
                    };
                    const validAssignments = assignments.filter(a => a.checklist && a.asset);
 if (validAssignments.length === 0 && totalAssets === 0) {
                    %>
                    <div class="text-center py-12">
                        <h3 class="text-lg font-medium text-gray-700">No maintenance tasks assigned.</h3>
<p class="text-gray-500 mt-1">Please check back later.</p>
                    </div>
                    <% } else if (validAssignments.length === 0 && totalAssets > 0) { %>
                    <div class="text-center py-12">
                        <h3 class="text-lg font-medium text-gray-700">No tasks found for the selected filters.</h3>
                    </div>
                    <% } else {
                    const groupedAssignments = {};
 validAssignments.forEach(function(assignment) {
                        const assetId = assignment.asset._id.toString();
                        if (!groupedAssignments[assetId]) {
                        groupedAssignments[assetId] = {
        asset: assignment.asset,
                            checklists: []
                        };
                        }
          groupedAssignments[assetId].checklists.push(assignment);
                    });
 %>
                    <div class="space-y-4">
                        <% Object.keys(groupedAssignments).forEach(function(assetId) {
                        const group = groupedAssignments[assetId];
                        const asset = group.asset;
                        const assetName = asset.name;
            
                        const uniqueGroupId = `asset-group-${assetId}`;
                        %>
         
               <div class="rounded-lg shadow-sm bg-white overflow-hidden border asset-card"
                            data-name="<%= assetName.toLowerCase() %>"
                            data-floor="<%= asset.floor?.name?.toLowerCase() || '' %>"
                            data-category="<%= asset.category?.name?.toLowerCase() || '' %>">

                            <div class="bg-gray-50 px-4 py-3 font-semibold flex justify-between items-center cursor-pointer hover:bg-gray-100 transition"
                            onclick="toggleDropdown('<%= uniqueGroupId %>')">
                 
           <div class="flex items-center">
                                <span class="text-xl mr-3"><%= getAssetIcon(assetName) %></span>
                                <div>
             <p class="text-md text-gray-800"><%= assetName %></p>
            
                                <p class="text-xs text-gray-500">
                                    Fl.
 <%= asset.floor?.name || 'N/A' %> / Zone <%= asset.zone?.name ||
 'N/A' %> / <%= asset.location %>
                                </p>
                                </div>
                            </div>
   
                         <span id="arrow-<%= uniqueGroupId %>" class="transition-transform duration-200 transform text-gray-500">▼</span>
                            </div>

                            <div id="<%= uniqueGroupId %>" class="dropdown-content hidden p-4 space-y-3">
     
                       <% group.checklists.forEach(function(assignment) { %>
                                <div class="flex flex-col sm:flex-row justify-between sm:items-center p-3 border rounded-md hover:bg-gray-50">
                                <div>
 
                                   <p class="font-semibold text-gray-800"><%= assignment.checklist.title %></p>
                                    <p class="text-xs text-gray-500">Assigned: <%= new Date(assignment.assignedAt).toLocaleDateString() %></p>
                   
             </div>
                                <button
                                    onclick="startChecklist('<%= assignment._id %>')"
                 
                   class="mt-2 sm:mt-0 text-center text-sm px-4 py-2 bg-blue-100 hover:bg-blue-200 text-blue-800 font-semibold rounded-lg transition">
                                    Start Checklist
                                </button>
 
                               </div>
                            <% });
 %>
                            </div>
                        </div>
                        <% });
 %>
                    </div>

                    <% if (totalPages > 1) { %>
                        <div class="px-6 py-4 bg-white border-t flex flex-col xs:flex-row items-center xs:justify-between">
                            <span class="text-xs xs:text-sm text-gray-700">
                                Showing page <%= currentPage %> of <%= totalPages %>
                            </span>
                            <div class="inline-flex mt-2 xs:mt-0">
                                <%
                                    const queryParams = new URLSearchParams({
                                        search: currentSearch,
                                        floor: currentFloor,
                                        category: currentCategory,
                                        zone: currentZone
                                    });
                                %>
                                <% if (currentPage > 1) { %>
                                    <% queryParams.set('page', currentPage - 1); %>
                                    <a href="/technician/dashboard?<%= queryParams.toString() %>" class="text-sm bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-2 px-4 rounded-l">
                                        Prev
                                    </a>
                                <% } %>
                                <% if (currentPage < totalPages) { %>
                                    <% queryParams.set('page', currentPage + 1); %>
                                    <a href="/technician/dashboard?<%= queryParams.toString() %>" class="text-sm bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-2 px-4 rounded-r">
                                        Next
                                    </a>
                                <% } %>
                            </div>
                        </div>
                    <% } %>

                    <% } %>
                </div>
            </div>

            <div class="bg-white p-6 rounded-lg shadow-lg">
              
  <h2 class="text-xl font-bold mb-4">Recent Activities</h2>
                <div class="h-96 overflow-y-auto">
                    <ul>
                        <% if (locals.activities && activities.length > 0) { %>
                        
    <% activities.forEach(function(activity) { %>
                            <li class="border-b last:border-b-0 py-3">
                                <p class="text-sm text-gray-800"><strong><%= (activity.user && activity.user.name) || (activity.user.id && activity.user.id.name) || 'System' %></strong> (<%= activity.role %>) <%= activity.action %></p>
            
                    <p class="text-xs text-gray-500 mt-1"><%= new Date(activity.timestamp).toLocaleString() %></p>
                            </li>
                            <% });
 %>
                        <% } else { %>
                            <p class="text-gray-500">No recent activities.</p>
                        <% } %>
               
     </ul>
                </div>
            </div>
        </div>
    </div>
  </main>

  <div class="fixed inset-x-0 bottom-0 bg-white border-t shadow-lg md:hidden">
    <div class="flex justify-around py-2">
      <a href="/technician/dashboard" class="flex flex-col items-center text-blue-600">
        <svg class="w-6 h-6 mb-1" fill="currentColor" viewBox="0 0 20 20"><path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"></path></svg>
        <span class="text-xs">Dashboard</span>
      </a>
      <a id="my-reports-link-mobile" href="/technician/report" class="flex flex-col items-center text-gray-500 hover:text-blue-600">
        <svg class="w-6 h-6 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-6a2 2 0 012-2h2a2 2 0 012 2v6m-6 0h6"></path></svg>
        <span class="text-xs">My Reports</span>
      
</a>
    </div>
  </div>
  
  <div id="sync-modal" class="fixed z-20 inset-0 overflow-y-auto hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
  <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
    <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" aria-hidden="true"></div>
    <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>
    <div class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full">
      <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
        <div class="sm:flex sm:items-start">
          <div 
 id="sync-modal-icon" class="mx-auto flex-shrink-0 flex items-center justify-center h-12 w-12 rounded-full bg-blue-100 sm:mx-0 sm:h-10 sm:w-10">
            <svg class="h-6 w-6 text-blue-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 12L3 12m4 4l4-4m6 0v12m0-12l4 4m-4-4l-4 4" />
            </svg>
          </div>
          <div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left">
   
         <h3 class="text-lg leading-6 font-medium text-gray-900" id="sync-modal-title">
              Confirm Sync
            </h3>
            <div class="mt-2">
              <p class="text-sm text-gray-500" id="sync-modal-body">
                Are you sure you want to sync your offline data with the server?
 </p>
            </div>
          </div>
        </div>
      </div>
      <div class="bg-gray-50 px-4 py-3 sm:px-6 sm:flex sm:flex-row-reverse">
        <button id="confirm-sync-btn" type="button" class="w-full inline-flex justify-center rounded-md border border-transparent shadow-sm px-4 py-2 bg-blue-600 text-base font-medium text-white hover:bg-blue-700 sm:ml-3 sm:w-auto sm:text-sm">
          Sync
        </button>
       
  <button id="cancel-sync-btn" type="button" class="mt-3 w-full inline-flex justify-center rounded-md border border-gray-300 shadow-sm px-4 py-2 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 sm:mt-0 sm:w-auto sm:text-sm">
          Cancel
        </button>
      </div>
    </div>
  </div>
</div>


  <script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>
  <script src="https://unpkg.com/dexie@3.2.5/dist/dexie.js"></script>
  <script src="/js/db.js"></script>

  <script>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/service-worker.js');
 });
    }

    async function syncWithServer() {
        if (!navigator.onLine) return;
 try {
            const response = await fetch('/api/technician/sync-data');
 if (!response.ok) throw new Error(`Server responded with status: ${response.status}`);
            const data = await response.json();
            await cacheData(data.assets, data.assignments, data.checklists);
 console.log("Successfully synced with server.");
        } catch (error) {
            console.error("Failed to sync with server:", error);
 }
    }

    document.addEventListener('DOMContentLoaded', (event) => {
      syncWithServer();

      const updateOnlineStatus = async () => {
        const online = navigator.onLine;

        const indicators = [
            {
                indicator: document.getElementById('status-indicator-desktop'),
                dot: document.getElementById('status-dot-desktop'),
   
             text: document.getElementById('status-text-desktop'),
                dotClass: 'w-3 h-3'
            },
            {
                indicator: document.getElementById('status-indicator-mobile'),
                dot: document.getElementById('status-dot-mobile'),
          
      text: document.getElementById('status-text-mobile'),
                dotClass: 'w-2 h-2'
            }
        ];

        const syncNowBtn = document.getElementById('sync-now-btn');
        const pendingSyncAlert = document.getElementById('pending-sync-alert');
        const pendingSyncCount = document.getElementById('pending-sync-count');
 const desktopReportLink = document.getElementById('my-reports-link-desktop');
        const mobileReportLink = document.getElementById('my-reports-link-mobile');

        indicators.forEach(({ indicator, dot, text, dotClass }) => {
            if (online) {
                dot.className = `${dotClass} rounded-full bg-green-500`;
                text.textContent = 'Online';
                indicator.className = indicator.className.replace(/bg-red-100 text-red-800/g, 'bg-green-100 text-green-800');
            
} else {
                dot.className = `${dotClass} rounded-full bg-red-500`;
                text.textContent = 'Offline';
                indicator.className = indicator.className.replace(/bg-green-100 text-green-800/g, 'bg-red-100 text-red-800');
            }
        });
 if (online) {
            syncNowBtn.classList.remove('hidden');
            if (desktopReportLink) desktopReportLink.href = '/technician/report';
 if (mobileReportLink) mobileReportLink.href = '/technician/report';
            await syncWithServer(); 
            forceSync();
        } else {
            syncNowBtn.classList.add('hidden');
 if (desktopReportLink) desktopReportLink.href = '/offline-report.html';
            if (mobileReportLink) mobileReportLink.href = '/offline-report.html';
 }

        const pendingCount = await countPendingSubmissions();
        pendingSyncAlert.classList.toggle('hidden', pendingCount === 0);
        pendingSyncCount.textContent = pendingCount;
 };

      window.addEventListener('online', updateOnlineStatus);
      window.addEventListener('offline', updateOnlineStatus);
      updateOnlineStatus();

      const scanBtn = document.getElementById('scan-qr-btn');
      const qrReaderElement = document.getElementById('qr-reader');
      const html5QrCode = new Html5Qrcode("qr-reader");
 const onScanSuccess = (decodedText, decodedResult) => {
        html5QrCode.stop().then(() => {
          window.location.href = navigator.onLine ? `/technician/asset/${decodedText}` : `/offline-asset.html#${decodedText}`;
        }).catch(err => console.error("Error stopping scanner:", err));
 };
      
      scanBtn.addEventListener('click', () => {
        const isHidden = qrReaderElement.classList.contains('hidden');
        if (isHidden) {
          qrReaderElement.classList.remove('hidden');
          html5QrCode.start({ facingMode: "environment" }, { fps: 10, qrbox: { width: 250, height: 250 } }, onScanSuccess, () => {})
            .catch(err => alert(`Could not start camera. Error: ${err}`));
        } else {
        
  html5QrCode.stop().then(() => qrReaderElement.classList.add('hidden'));
        }
      });
      
      // Dynamic Zone Filtering
      const floorFilter = document.getElementById('floorFilter');
      const zoneFilter = document.getElementById('zoneFilter');
      const allZoneOptions = Array.from(document.querySelectorAll('.zone-option'));

      function updateZoneFilter() {
          const selectedFloorOption = floorFilter.options[floorFilter.selectedIndex];
          const selectedFloorId = selectedFloorOption.dataset.floorId;
          
          const currentZoneValue = zoneFilter.value;
          
          allZoneOptions.forEach(option => {
              option.classList.add('hidden');
              if (selectedFloorId && option.dataset.floorOfZone === selectedFloorId) {
                  option.classList.remove('hidden');
              }
          });
          
          if (selectedFloorId) {
              const firstVisibleZone = allZoneOptions.find(opt => !opt.classList.contains('hidden'));
              if (firstVisibleZone) {
                  if (zoneFilter.querySelector(`option[value="${currentZoneValue}"]:not(.hidden)`)) {
                      zoneFilter.value = currentZoneValue;
                  }
              }
          }
      }
      
      floorFilter.addEventListener('change', () => {
        zoneFilter.value = 'all'; // Reset zone when floor changes
        document.getElementById('filter-form').submit();
      });
      // Initial call to set zones based on pre-selected floor (if any)
      updateZoneFilter();
      
      
    const syncModal = document.getElementById('sync-modal');
    const syncNowBtn = document.getElementById('sync-now-btn');
    const confirmSyncBtn = document.getElementById('confirm-sync-btn');
 const cancelSyncBtn = document.getElementById('cancel-sync-btn');

    syncNowBtn.addEventListener('click', () => {
        syncModal.classList.remove('hidden');
    });
 cancelSyncBtn.addEventListener('click', () => {
        syncModal.classList.add('hidden');
    });
 confirmSyncBtn.addEventListener('click', async () => {
        const modalTitle = document.getElementById('sync-modal-title');
        const modalBody = document.getElementById('sync-modal-body');
        const modalIcon = document.getElementById('sync-modal-icon');

        modalTitle.textContent = 'Syncing...';
        modalBody.textContent = 'Please wait while we sync your data.';
        confirmSyncBtn.disabled = true;
        cancelSyncBtn.disabled = true;

        const result = await forceSync();

     
    if (result.failed > 0) {
            modalTitle.textContent = 'Sync Failed';
            modalBody.textContent = `Could not sync ${result.failed} submission(s). Please check your connection and try again.`;
            modalIcon.innerHTML = `<svg class="h-6 w-6 text-red-600" ... >...</svg>`; // Error icon
        } else {
            modalTitle.textContent = 'Sync Complete';
      
       modalBody.textContent = `${result.successful} offline submission(s) have been successfully uploaded.`;
 modalIcon.innerHTML = `<svg class="h-6 w-6 text-green-600" ... >...</svg>`; // Success icon
        }

        confirmSyncBtn.disabled = false;
 cancelSyncBtn.textContent = 'Close';
        cancelSyncBtn.disabled = false;
        confirmSyncBtn.classList.add('hidden');
        
        updateOnlineStatus(); // To update the pending count
    });
    });

    function toggleDropdown(id) {
      document.getElementById(id)?.classList.toggle('hidden');
      document.getElementById('arrow-' + id)?.classList.toggle('rotate-180');
 }

    function startChecklist(assignmentId) {
      window.location.href = navigator.onLine ? `/technician/checklist/${assignmentId}` : `/offline-checklist.html#${assignmentId}`;
 }
  </script>
</body>
</html>