<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manager Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="bg-gray-100">
<div class="container mx-auto p-4">
    <h1 class="text-3xl font-bold mb-6 text-center">Manager Dashboard</h1>

    <form method="GET" action="/manager/dashboard" class="mb-4 flex flex-col sm:flex-row gap-4 items-center">
        <!-- Division Filter -->
        <div class="flex-1 w-full">
            <label for="division_filter" class="block text-sm font-medium text-gray-700">Filter by Division</label>
            <select name="division" id="division_filter" onchange="this.form.submit()" class="mt-1 block w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm rounded-md">
                <option value="all" <%= currentDivision === 'all' ? 'selected' : '' %>>All Divisions</option>
                <% divisions.forEach(div => { %>
                <option value="<%= div._id %>" <%= currentDivision === div._id.toString() ? 'selected' : '' %>>
                    <%= div.name %>
                </option>
                <% }) %>
            </select>
        </div>
        <!-- Status Filter -->
        <div class="flex-1 w-full">
            <label for="status_filter" class="block text-sm font-medium text-gray-700">Filter by Status</label>
            <select name="filter" id="status_filter" onchange="this.form.submit()" class="mt-1 block w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm rounded-md">
                <option value="all" <%= currentFilter === 'all' ? 'selected' : '' %>>All Reports</option>
                <option value="has_alert" <%= currentFilter === 'has_alert' ? 'selected' : '' %>>With Alerts</option>
                <option value="rejected" <%= currentFilter === 'rejected' ? 'selected' : '' %>>Rejected</option>
            </select>
        </div>
    </form>

    <div class="overflow-x-auto bg-white shadow rounded-lg">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Asset / Checklist</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Technician / Date</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Verification Status</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
            <% if (assignments.length > 0) { %>
                <% assignments.forEach(assignment => { %>
                <tr class="<%= assignment.hasAlert && assignment.verifiedStatus !== 'rejected' ? 'bg-yellow-50' : '' %> <%= assignment.verifiedStatus === 'rejected' ? 'bg-red-50' : '' %>">
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm font-medium text-gray-900"><%= assignment.asset?.name || 'N/A' %></div>
                        <div class="text-sm text-gray-500"><%= assignment.checklist?.title || 'N/A' %></div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm text-gray-900"><%= assignment.submittedBy?.name || 'N/A' %></div>
                        <div class="text-sm text-gray-500"><%= new Date(assignment.completedAt).toLocaleString() %></div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <% if (assignment.verifiedStatus === 'rejected') { %>
                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">Rejected</span>
                        <% } else if (assignment.verifiedByManager) { %>
                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">Verified by Manager</span>
                        <% } else if (assignment.verifiedBySpv) { %>
                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-blue-100 text-blue-800">Verified by SPV</span>
                        <% } else { %>
                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-gray-100 text-gray-800">Pending SPV</span>
                        <% } %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                        <a href="/manager/report/<%= assignment._id %>/detail" class="text-indigo-600 hover:text-indigo-900 mr-4">Detail</a>
                        <% if (assignment.verifiedStatus !== 'rejected' && assignment.verifiedBySpv && !assignment.verifiedByManager) { %>
                            <form method="POST" action="/manager/report/<%= assignment._id %>/verify" class="inline">
                                <button type="submit" class="text-green-600 hover:text-green-900">Verify</button>
                            </form>
                        <% } %>
                        <% if (assignment.verifiedStatus !== 'rejected') { %>
                            <form method="POST" action="/manager/report/<%= assignment._id %>/reject" class="inline ml-4">
                                <button type="submit" class="text-red-600 hover:text-red-900">Reject</button>
                            </form>
                        <% } %>
                    </td>
                </tr>
                <% }); %>
            <% } else { %>
                <tr>
                    <td colspan="4" class="px-6 py-4 text-center text-sm text-gray-500">No reports found.</td>
                </tr>
            <% } %>
            </tbody>
        </table>
    </div>
    <div class="mt-6 text-center">
        <a href="/logout" class="text-indigo-600 hover:text-indigo-900">Logout</a>
    </div>
</div>
</body>
</html>
